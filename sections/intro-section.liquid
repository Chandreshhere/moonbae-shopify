{% render 'section-class', classes: 'page-contain u-container is-section', attrs: 'nav-dark', pt: section.settings.padding_top, pb: section.settings.padding_bottom %}
<div class="split-grid u-grid-desktop m-vflex">

<div class="split-col u-column-6">
  <div class="full-logo_wrap">{% render 'brand-mono', setting: section.settings.mark_image, variant: 'dark', size: section.settings.mark_size, class: 'is-intro' %}</div>
</div>
<div class="split-col u-column-6 m-top_10">
  <div class="u-text-style-h3">
    <h3 class="p-contents">{{ section.settings.text }}</h3>
  </div>
</div>
</div>

{% schema %}
{
  "name": "Intro",
  "tag": "div",
  "class": "page-contain u-container is-section",
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Intro copy",
      "default": "<p>Born from a shared love of the game, rooted in a vision of authenticity and creativity expressed through what we wear. For us, it's about the good times, on and off the course, self-expression, and an appreciation for the cultural overlaps we get to experience along the way.</p>"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 320,
      "step": 4,
      "default": 0,
      "unit": "px",
      "info": "0 keeps the design default."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 320,
      "step": 4,
      "default": 0,
      "unit": "px",
      "info": "0 keeps the design default."
    },
    {
      "type": "image_picker",
      "id": "mark_image",
      "label": "Monogram image",
      "info": "Overrides the theme Brand marks monogram for this section only."
    },
    {
      "type": "range",
      "id": "mark_size",
      "label": "Monogram height",
      "min": 0,
      "max": 600,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 keeps the design default, which also scales down on mobile. Any other value fixes the height on every screen."
    }
  ],
  "presets": [
    {
      "name": "Intro",
      "category": "Home"
    }
  ]
}
{% endschema %}
