{% render 'section-class', id: 'shopify-section-footer-dark', classes: 'footer u-theme-dark', attrs: 'img-hover_wrap' %}

{% render 'footer-body', theme: 'dark', section: section %}

{% schema %}
{
  "name": "Footer (dark)",
  "tag": "footer",
  "class": "footer u-theme-dark",
  "max_blocks": 4,
  "settings": [
    {
      "type": "richtext",
      "id": "tagline",
      "label": "Tagline",
      "default": "<p>moonbae<br/>a modern expression of heritage</p>"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright",
      "default": "All rights reserved _ moonbae ©2025"
    },
    {
      "type": "text",
      "id": "credit_label",
      "label": "Credit label",
      "default": "Website by malvah"
    },
    {
      "type": "url",
      "id": "credit_url",
      "label": "Credit URL"
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo image",
      "info": "Overrides the theme Brand marks logo for this footer only."
    },
    {
      "type": "range",
      "id": "logo_size",
      "label": "Logo height",
      "min": 0,
      "max": 400,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 keeps the design default, which also scales down on mobile. Any other value fixes the height on every screen."
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Site Index"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "info": "Leave empty to use the manual links below."
        },
        {
          "type": "checkbox",
          "id": "hover_images",
          "label": "Show hover images",
          "default": false
        },
        {
          "type": "text",
          "id": "link_1_label",
          "label": "Link 1 label"
        },
        {
          "type": "url",
          "id": "link_1_url",
          "label": "Link 1 URL"
        },
        {
          "type": "text",
          "id": "link_2_label",
          "label": "Link 2 label"
        },
        {
          "type": "url",
          "id": "link_2_url",
          "label": "Link 2 URL"
        },
        {
          "type": "text",
          "id": "link_3_label",
          "label": "Link 3 label"
        },
        {
          "type": "url",
          "id": "link_3_url",
          "label": "Link 3 URL"
        },
        {
          "type": "text",
          "id": "link_4_label",
          "label": "Link 4 label"
        },
        {
          "type": "url",
          "id": "link_4_url",
          "label": "Link 4 URL"
        }
      ]
    },
    {
      "type": "hover_image",
      "name": "Link hover image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text",
          "info": "Describes the image for screen readers and search engines."
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "column",
        "settings": {
          "heading": "Site Index",
          "hover_images": true,
          "link_1_label": "Shop now",
          "link_1_url": "/collections",
          "link_2_label": "Home",
          "link_2_url": "/",
          "link_3_label": "About us",
          "link_3_url": "/pages/about",
          "link_4_label": "Contact Us",
          "link_4_url": "/pages/contact-us"
        }
      },
      {
        "type": "column",
        "settings": {
          "heading": "Social",
          "link_1_label": "Instagram",
          "link_1_url": "https://www.instagram.com/oddritual.gc/"
        }
      },
      {
        "type": "column",
        "settings": {
          "heading": "Get in touch",
          "link_1_label": "hello@oddritualgolf.com",
          "link_1_url": "mailto:hello@oddritualgolf.com?subject=moonbae%20-%20Customer%20Support",
          "link_2_label": "+27 76 207 33 87",
          "link_2_url": "tel:+27763091991"
        }
      },
      {
        "type": "column",
        "settings": {
          "heading": "legal",
          "link_1_label": "Privacy Policy",
          "link_1_url": "/pages/privacy-policy",
          "link_2_label": "Refunds",
          "link_2_url": "/pages/refund-policy",
          "link_3_label": "Shipping",
          "link_3_url": "/pages/shipping-policy",
          "link_4_label": "Terms of service",
          "link_4_url": "/pages/terms-of-service"
        }
      },
      {
        "type": "hover_image"
      },
      {
        "type": "hover_image"
      },
      {
        "type": "hover_image"
      },
      {
        "type": "hover_image"
      }
    ]
  }
}
{% endschema %}
