{%- comment -%}
  Shop tiles: one row of image tiles, all the same height, each with its title,
  a small line and a link always visible (the old version only showed them on
  mouse hover, which phones never do). Desktop widths come from each tile's
  Width setting on a 12-column row; on phones a Half tile spans the row and the
  others sit two to a row.
{%- endcomment -%}
{% render 'section-class', classes: 'page-contain u-container is-section shop-tiles-section', attrs: 'nav-dark', pt: section.settings.padding_top, pb: section.settings.padding_bottom %}
<div class="shop-tiles" style="--shop-tiles-h: {{ section.settings.tile_height }}svh; --shop-tiles-h-m: {{ section.settings.mobile_height }}svh;">
  {%- if section.settings.heading != blank -%}
    <h2 class="shop-tiles_heading">{{ section.settings.heading }}</h2>
  {%- endif -%}
  <div class="shop-tiles_grid">
    {%- assign tile_fallbacks = 'moonbae-07.jpg,moonbae-04.jpg,hero-men.jpg,moonbae-05.jpg' | split: ',' -%}
    {%- for block in section.blocks -%}
      {%- liquid
        assign fb = tile_fallbacks[forloop.index0] | default: 'moonbae-07.jpg'
        assign span = block.settings.width | default: '6'
        capture img_attrs
          echo 'style="object-position: ' | append: block.settings.focus | append: '"'
        endcapture
      -%}
      <a href="{{ block.settings.link_url | default: '/collections/all' }}"{% if block.settings.new_tab %} target="_blank" rel="noopener"{% endif %}
         class="shop-tile{% if span == '6' %} is-wide{% endif %}" style="--span: {{ span }};" {{ block.shopify_attributes }}>
        <div class="shop-tile_visual">
          {% render 'img', image: block.settings.image, fallback: fb, fallback_width: '1400x', alt: block.settings.eyebrow, class: 'shop-tile_img', sizes: '(max-width: 767px) 100vw, 50vw', attrs: img_attrs %}
        </div>
        <div class="shop-tile_scrim" aria-hidden="true"></div>
        <div class="shop-tile_label">
          {%- if block.settings.hover_title != blank -%}
            <span class="shop-tile_kicker body-upper">{{ block.settings.hover_title }}</span>
          {%- endif -%}
          <h3 class="shop-tile_title">{{ block.settings.eyebrow }}</h3>
          {%- if block.settings.hover_link_label != blank -%}
            <span class="shop-tile_cta body-upper">{{ block.settings.hover_link_label }} <span aria-hidden="true">&rarr;</span></span>
          {%- endif -%}
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Shop tiles",
  "tag": "div",
  "class": "page-contain u-container is-section shop-tiles-section",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "cta",
      "name": "Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "focus",
          "label": "Image focus",
          "default": "center center",
          "options": [
            { "value": "left center", "label": "Left" },
            { "value": "center center", "label": "Centre" },
            { "value": "right center", "label": "Right" },
            { "value": "center top", "label": "Top" }
          ],
          "info": "Which part of the image stays in view when the tile crops it."
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Title",
          "default": "Shop"
        },
        {
          "type": "text",
          "id": "hover_title",
          "label": "Small line above the title",
          "default": "ALL PRODUCTS"
        },
        {
          "type": "text",
          "id": "hover_link_label",
          "label": "Link text",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "new_tab",
          "label": "Open in new tab",
          "default": false
        },
        {
          "type": "select",
          "id": "width",
          "label": "Width on desktop",
          "default": "6",
          "options": [
            { "value": "3", "label": "Quarter" },
            { "value": "4", "label": "Third" },
            { "value": "6", "label": "Half" }
          ],
          "info": "On phones a Half tile spans the row; the others sit two to a row."
        },
        {
          "type": "checkbox",
          "id": "full_height",
          "label": "Full height",
          "default": true,
          "info": "Kept from the previous layout and no longer used: every tile is the same height, set on the section."
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Optional. Shown above the tiles."
    },
    {
      "type": "range",
      "id": "tile_height",
      "label": "Tile height on desktop",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 75,
      "info": "Share of the screen height."
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Tile height on phones",
      "min": 30,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 320,
      "step": 4,
      "default": 0,
      "unit": "px",
      "info": "0 keeps the design default."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 320,
      "step": 4,
      "default": 0,
      "unit": "px",
      "info": "0 keeps the design default."
    }
  ],
  "presets": [
    {
      "name": "Shop tiles",
      "category": "Home",
      "blocks": [
        {
          "type": "cta",
          "settings": {
            "eyebrow": "Shop",
            "hover_title": "ALL PRODUCTS",
            "hover_link_label": "Shop now",
            "link_url": "/collections/all",
            "width": "6"
          }
        },
        {
          "type": "cta",
          "settings": {
            "eyebrow": "Women",
            "hover_title": "FOR HER",
            "hover_link_label": "Shop for her",
            "link_url": "/collections/women",
            "width": "3"
          }
        },
        {
          "type": "cta",
          "settings": {
            "eyebrow": "Men",
            "hover_title": "FOR HIM",
            "hover_link_label": "Shop for him",
            "link_url": "/collections/men",
            "width": "3"
          }
        }
      ]
    }
  ]
}
{% endschema %}
