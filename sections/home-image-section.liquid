{%- comment -%}
  Shop tiles: full-bleed image tiles side by side, edge to edge, split by a
  thin line, each with a large title in its bottom-left corner. Desktop widths
  come from each tile's Width setting on a 12-column row (two Halves make the
  split screen). On phones the tiles sit two to a row; with an odd number the
  first one spans the row.
{%- endcomment -%}
{% render 'section-class', classes: 'page-contain is-section shop-tiles-section', attrs: 'nav-light', pt: section.settings.padding_top, pb: section.settings.padding_bottom %}
{%- if section.settings.title_style == 'condensed' -%}
  {%- assign title_font = section.settings.title_font -%}
  <style>
    {{ title_font | font_face: font_display: 'swap' }}
    .shop-tiles--{{ section.id }} .shop-tile_title {
      font-family: {{ title_font.family }}, {{ title_font.fallback_families }};
      font-weight: {{ title_font.weight }};
    }
  </style>
{%- endif -%}
<div class="shop-tiles shop-tiles--{{ section.id }} is-{{ section.settings.title_style }}" style="--shop-tiles-h: {{ section.settings.tile_height }}svh; --shop-tiles-h-m: {{ section.settings.mobile_height }}svh;">
  {%- if section.settings.heading != blank -%}
    <h2 class="shop-tiles_heading u-container">{{ section.settings.heading }}</h2>
  {%- endif -%}
  <div class="shop-tiles_grid">
    {%- assign tile_fallbacks = 'moonbae-07.jpg,moonbae-04.jpg,hero-men.jpg,moonbae-05.jpg' | split: ',' -%}
    {%- for block in section.blocks -%}
      {%- liquid
        assign fb = tile_fallbacks[forloop.index0] | default: 'moonbae-07.jpg'
        comment
          Pick the stand-in photo by where the tile goes, so swapping the
          order of Men and Women does not swap their pictures.
        endcomment
        assign link = block.settings.link_url | downcase
        if link contains '/women'
          assign fb = 'moonbae-04.jpg'
        elsif link contains '/men'
          assign fb = 'hero-men.jpg'
        endif
        assign span = block.settings.width | default: '6'
        capture img_attrs
          echo 'style="object-position: ' | append: block.settings.focus | append: '"'
        endcapture
      -%}
      <a href="{{ block.settings.link_url | default: '/collections/all' }}"{% if block.settings.new_tab %} target="_blank" rel="noopener"{% endif %}
         class="shop-tile{% if span == '6' %} is-wide{% endif %}" style="--span: {{ span }};" {{ block.shopify_attributes }}>
        <div class="shop-tile_visual">
          {% render 'img', image: block.settings.image, fallback: fb, fallback_width: '1800x', alt: block.settings.eyebrow, class: 'shop-tile_img', sizes: '(max-width: 767px) 50vw, 50vw', attrs: img_attrs %}
        </div>
        <div class="shop-tile_scrim" aria-hidden="true"></div>
        <div class="shop-tile_label">
          {%- if block.settings.hover_title != blank -%}
            <span class="shop-tile_kicker body-upper">{{ block.settings.hover_title }}</span>
          {%- endif -%}
          <h3 class="shop-tile_title">{{ block.settings.eyebrow }}</h3>
          {%- if block.settings.hover_link_label != blank -%}
            <span class="shop-tile_cta body-upper">{{ block.settings.hover_link_label }} <span aria-hidden="true">&rarr;</span></span>
          {%- endif -%}
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Shop tiles",
  "tag": "div",
  "class": "page-contain is-section shop-tiles-section",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "cta",
      "name": "Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "focus",
          "label": "Image focus",
          "default": "center center",
          "options": [
            { "value": "left center", "label": "Left" },
            { "value": "30% center", "label": "Left of centre" },
            { "value": "center center", "label": "Centre" },
            { "value": "70% center", "label": "Right of centre" },
            { "value": "right center", "label": "Right" },
            { "value": "center top", "label": "Top" }
          ],
          "info": "Which part of the image stays in view when the tile crops it."
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Title",
          "default": "Shop"
        },
        {
          "type": "text",
          "id": "hover_title",
          "label": "Small line above the title",
          "info": "Optional."
        },
        {
          "type": "text",
          "id": "hover_link_label",
          "label": "Link text",
          "info": "Optional. Shown under the title with an arrow."
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "new_tab",
          "label": "Open in new tab",
          "default": false
        },
        {
          "type": "select",
          "id": "width",
          "label": "Width on desktop",
          "default": "6",
          "options": [
            { "value": "3", "label": "Quarter" },
            { "value": "4", "label": "Third" },
            { "value": "6", "label": "Half" }
          ],
          "info": "Two Halves make a split screen. On phones tiles sit two to a row."
        },
        {
          "type": "checkbox",
          "id": "full_height",
          "label": "Full height",
          "default": true,
          "info": "Kept from the previous layout and no longer used: every tile is the same height, set on the section."
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Optional. Shown above the tiles."
    },
    {
      "type": "select",
      "id": "title_style",
      "label": "Tile title style",
      "default": "condensed",
      "options": [
        { "value": "condensed", "label": "Tall capitals" },
        { "value": "serif", "label": "Site serif" }
      ]
    },
    {
      "type": "font_picker",
      "id": "title_font",
      "label": "Font for tall capitals",
      "default": "oswald_n4"
    },
    {
      "type": "range",
      "id": "tile_height",
      "label": "Tile height on desktop",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 75,
      "info": "Share of the screen height. 100 fills the screen."
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Tile height on phones",
      "min": 30,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 60
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 320,
      "step": 4,
      "default": 0,
      "unit": "px",
      "info": "0 keeps the design default."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 320,
      "step": 4,
      "default": 0,
      "unit": "px",
      "info": "0 keeps the design default."
    }
  ],
  "presets": [
    {
      "name": "Shop tiles",
      "category": "Home",
      "settings": {
        "tile_height": 100
      },
      "blocks": [
        {
          "type": "cta",
          "settings": {
            "eyebrow": "Shop men",
            "link_url": "/collections/men",
            "width": "6"
          }
        },
        {
          "type": "cta",
          "settings": {
            "eyebrow": "Shop women",
            "link_url": "/collections/women",
            "width": "6"
          }
        }
      ]
    }
  ]
}
{% endschema %}
