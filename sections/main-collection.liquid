{%- comment -%}
  A category page gets a full-bleed hero, so Men, Women and Accessories each
  arrive with a face rather than as three identical grids with a different word
  at the top.

  Three places it looks for the picture, in order: the collection's own image
  from Shopify admin, which is how a category gets a face of its own; the
  section's shared fallback, which dresses every category at once; and a bundled
  asset, so a page is never bare while a shop is still being built. Every
  collection has a hero — waiting on the merchant to upload something meant the
  categories sat empty, which is the one state worth designing out.
{%- endcomment -%}
{%- liquid
  comment
    Filters are not allowed inside a render tag's arguments — Liquid rejects
    the tag, and Shopify then refuses the whole file. Resolve the title here.
  endcomment
  assign page_title = collection.title | default: section.settings.fallback_title
  assign hero_image = collection.image
  if hero_image == blank
    assign hero_image = section.settings.hero_fallback_image
  endif
  comment
    Men and Women ship with a bundled hero of their own, keyed by collection
    handle, so the category pages are dressed before a Collection image is
    uploaded in admin. Anything else falls to the shared bundled image.
  endcomment
  assign hero_fallback = 'moonbae-07.jpg'
  assign bundled_heroes = 'men:hero-men.jpg,mens:hero-men.jpg,women:hero-women.jpg,womens:hero-women.jpg,for-her:hero-women.jpg' | split: ','
  for pair in bundled_heroes
    assign parts = pair | split: ':'
    if parts[0] == collection.handle
      assign hero_fallback = parts[1]
    endif
  endfor
  assign hero_fit_class = ''
  if section.settings.hero_fit == 'contain'
    assign hero_fit_class = 'is-contain'
  endif
  assign has_hero = true
  comment
    A hero page drops u-container from the section wrapper and hands it to the
    block below the hero instead. The alternative was leaving the wrapper
    capped at 90rem and letting the hero escape with width:100vw and negative
    margins — but vw counts the scrollbar and the container does not, so on
    every platform with a classic scrollbar the hero sat half a scrollbar to
    the left of the grid underneath it. Nothing is constraining it now, so
    there is nothing to escape from.
  endcomment
  assign wrapper_classes = 'page-collection u-container'
  assign below_hero_classes = 'dark-section_wrap'
  if has_hero
    assign wrapper_classes = 'page-collection has-hero'
    assign below_hero_classes = 'dark-section_wrap u-container'
  endif
-%}
{% render 'section-class', classes: wrapper_classes, attrs: 'count-items', pt: section.settings.padding_top, pb: section.settings.padding_bottom %}
<h1 class="u-visually-hidden">{{ collection.title | default: section.settings.fallback_title }}</h1>

{%- paginate collection.products by section.settings.products_per_page -%}
<div class="page-inner">
  {%- if has_hero -%}
    {%- comment -%}
      nav-light so the header turns white while it is over the photograph; the
      dark-section_wrap below carries nav-dark and takes it back for the grid.
    {%- endcomment -%}
    {%- capture hero_text -%}
      {%- if collection.description != blank -%}
        {{- collection.description | strip_html | truncatewords: 26 -}}
      {%- endif -%}
    {%- endcapture -%}
    {% render 'page-hero',
        image: hero_image,
        title: page_title,
        eyebrow: section.settings.eyebrow,
        text: hero_text,
        count: collection.products_count,
        count_attr: 'count-items="total"',
        fallback: hero_fallback,
        modifier: hero_fit_class,
        height: section.settings.hero_height %}
  {%- endif -%}

  <div nav-dark="" class="{{ below_hero_classes }}">
    {%- comment -%}
      The hero already carries the title and the count, so the intro row would
      only say them a second time.
    {%- endcomment -%}
    {%- unless has_hero -%}
    <div class="page-intro">
      <div class="shop-contain u-container">
        <div class="shop-intro_wrap">
          <div class="split-grid u-grid-desktop m-flex m-gap_0">
            <div class="split-col u-column-6 m-width_6">
              <div class="body-upper">
                <p>{{ collection.title | default: section.settings.fallback_title }}</p>
              </div>
            </div>
            <div class="split-col u-column-2 m-col_6">
              <div class="body-upper">{{ section.settings.eyebrow }}</div>
            </div>
            <div class="split-col u-column-4 u-text-align-right m-push_right m-col_6">
              <p class="body-upper">(&nbsp;<span count-items="total">{{ collection.products_count }}</span>&nbsp;)</p>
            </div>
          </div>
        </div>
      </div>
    </div>
    {%- endunless -%}

    <div class="collection-layout{% if collection.filters.size > 0 %} has-filters{% endif %}">
      {% render 'collection-toolbar', collection: collection, section: section %}
      {% render 'collection-filters', collection: collection, section: section %}

      <div class="product-col_wrap w-dyn-list" udy-collection="product">
      <div role="list" class="product-col_list u-grid-desktop w-dyn-items">
        {%- for product in collection.products -%}
          {% render 'product-card-grid', product: product, view_label: section.settings.view_label %}
        {%- else -%}
          <div class="product-col_item u-column-4">
            <p class="body-upper">{{ 'collections.general.no_matches' | t }}</p>
          </div>
        {%- endfor -%}
      </div>
      </div>
    </div>

    {%- if paginate.pages > 1 -%}
      <div class="shop-contain u-container">
        <div class="pagination body-upper">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">{{ paginate.previous.title }}</a>{%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- else -%}<span>{{ part.title }}</span>{%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}">{{ paginate.next.title }}</a>{%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection",
  "tag": "div",
  "class": "page-collection u-container",
  "settings": [
    {
      "type": "range",
      "id": "hero_height",
      "label": "Hero height",
      "min": 20,
      "max": 85,
      "step": 5,
      "unit": "%",
      "default": 60,
      "info": "Share of the screen the hero fills."
    },
    {
      "type": "select",
      "id": "hero_fit",
      "label": "Hero image",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Fill the hero (crops to fit)"
        },
        {
          "value": "contain",
          "label": "Show the whole image"
        }
      ],
      "info": "The bundled images are 16:9. At 60% height, Fill crops their top and bottom; Show the whole image letterboxes instead."
    },
    {
      "type": "image_picker",
      "id": "hero_fallback_image",
      "label": "Fallback hero image",
      "info": "Used on any collection that has no Collection image of its own. Set a Collection image in admin to give a category its own picture."
    },
    {
      "type": "text",
      "id": "fallback_title",
      "label": "Title when none set",
      "default": "All products"
    },
    {
      "type": "richtext",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "<p>moonbae ©2026</p>"
    },
    {
      "type": "text",
      "id": "filter_label",
      "label": "Filter heading",
      "default": "Filter",
      "info": "The rail only appears once filters are set up in Shopify's Search & Discovery app."
    },
    {
      "type": "text",
      "id": "sort_label",
      "label": "Sort label",
      "default": "Sort"
    },
    {
      "type": "text",
      "id": "view_label",
      "label": "Card hover label",
      "default": "View"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 12,
      "max": 48,
      "step": 4,
      "default": 48
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 320,
      "step": 4,
      "default": 0,
      "unit": "px",
      "info": "0 keeps the design default."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 320,
      "step": 4,
      "default": 0,
      "unit": "px",
      "info": "0 keeps the design default."
    }
  ]
}
{% endschema %}
