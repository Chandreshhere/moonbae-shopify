        },
        {
          "type": "flick"
        },
        {
          "type": "flick"
        },
        {
          "type": "sticky"
        },
        {
          "type": "sticky"
        },
        {
          "type": "sticky"
        },
        {
          "type": "sticky"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "flick",
      "name": "Flickthrough image",
