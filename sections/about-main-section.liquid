      "id": "story_left",
      "label": "Left column",
      "default": "<p>moonbae started in 2026 as a way to get artists' drawings onto clothes people would actually wear.</p>"
    },
    {
      "type": "richtext",
      "id": "story_right",
      "label": "Right column",
      "default": "<p>We work with each artist directly, print everything to order in India, and pay them for every piece sold.</p>"
    },
    {
      "type": "header",
      "content": "Outro"
    },
    {
      "type": "richtext",
      "id": "outro",
      "label": "Copy",
      "default": "<p>Follow us on Instagram for new artists and new drops.</p>"
