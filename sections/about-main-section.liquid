{% render 'section-class', classes: 'page-contain u-container-full page-about_contain', pt: section.settings.padding_top, pb: section.settings.padding_bottom %}

<div class="split-grid u-grid-desktop">
  <div class="split-col u-column-6">
    <div img-scroll="" class="about-img_right">
      {% render 'img', image: section.settings.portrait, fallback: 'moonbae-06.jpg', class: 'img-fill' %}
    </div>
  </div>
  <div nav-light="" class="split-col u-column-6">
    <div flickthrough-wrap="" img-scroll="" class="about-img_left">
      {%- assign flick_fallbacks = 'moonbae-07.jpg,moonbae-08.jpg,moonbae-09.jpg,moonbae-10.jpg,moonbae-01.jpg,moonbae-02.jpg,moonbae-03.jpg,moonbae-04.jpg' | split: ',' -%}
      {%- assign flick_i = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'flick' -%}
          {%- assign cls = 'flickthrough-img' -%}
          {%- if flick_i == 0 -%}{%- assign cls = 'flickthrough-img show' -%}{%- endif -%}
          {%- assign fb_index = flick_i | modulo: 8 -%}
          {% render 'img', image: block.settings.image, alt: block.settings.alt, fallback: flick_fallbacks[fb_index], class: cls, attrs: block.shopify_attributes %}
          {%- assign flick_i = flick_i | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
  <div nav-dark="" class="floating-icon">
    <div class="floating-icon_svg-wrap">{% render 'icon-floating' %}</div>
  </div>
</div>

<div class="vision-section">
  <div class="split-grid u-grid-desktop">
    <div class="split-col u-column-7"></div>
  </div>
  <div class="split-grid u-grid-desktop">
    <div class="split-col u-column-6">
      <div class="body-upper">
        <p>{{ section.settings.story_label }}</p>
      </div>
    </div>
    <div class="split-col u-column-6">
      <div class="u-text-style-h2">
        <h3 class="p-contents">{{ section.settings.story_heading }}</h3>
      </div>
    </div>
  </div>
  <div class="split-grid u-grid-desktop">
    <div class="split-col u-column-6"></div>
    <div class="split-col u-column-3">
      <div class="u-text-style-small f-5">{{ section.settings.story_left }}</div>
    </div>
    <div class="split-col u-column-3">
      <div class="u-text-style-small f-5">{{ section.settings.story_right }}</div>
    </div>
  </div>
</div>

<div class="sticky-component">
  <div class="sticky-wrap">
    {%- comment -%}
      Capped at four blocks: the CSS positions .sticky-item is-1 … is-5, and the
      fifth slot below is the fixed logo panel.
    {%- endcomment -%}
    {%- assign sticky_fallbacks = 'moonbae-05.jpg,moonbae-06.jpg,moonbae-07.jpg,moonbae-08.jpg' | split: ',' -%}
    {%- assign sticky_i = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'sticky' -%}
        {%- assign position = sticky_i | plus: 1 -%}
        <div class="sticky-item is-{{ position }}" {{ block.shopify_attributes }}>
          <div class="sticky-item_img">
            {% render 'img', image: block.settings.image, alt: block.settings.alt, fallback: sticky_fallbacks[sticky_i], class: 'img-fill' %}
          </div>
        </div>
        {%- assign sticky_i = sticky_i | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}

    <div class="sticky-item is-5 last-sticky_item">
      <div class="sticky-item_img">
        <div class="sticky-svg">{% render 'icon-sticky' %}</div>
      </div>
      <div class="u-container">
        <div class="or-info m-top-none">
          <div class="u-text-align-center"></div>
          <div class="split-grid u-grid-desktop">
            <div class="u-column-3 is-hidden"></div>
            <div class="u-column-6 text-width">
              <div class="u-vflex-center-top u-text-align-center">
                <div class="body-upper f-5">{{ section.settings.outro }}</div>
              </div>
            </div>
            <div class="u-column-3 u-text-align-right is-hidden"></div>
          </div>
          <div class="text-btn_wrap m-push_2">
            <a href="{{ section.settings.outro_url }}" target="_blank" class="orgc-detail w-inline-block">
              <div data-text="{{ section.settings.outro_label | escape }}" class="detail-wrap body-upper">
                <div class="detail-text">{{ section.settings.outro_label }}</div>
              </div>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="about-footer_contain u-container">
    {%- if section.settings.pillars != blank -%}
      <img src="{{ section.settings.pillars | image_url: width: 1400 }}" alt="" sizes="(max-width: 1400px) 100vw, 1400px" class="orgc-logo" width="{{ section.settings.pillars.width }}" height="{{ section.settings.pillars.height }}">
    {%- else -%}
      <img src="{{ 'moonbae-09.jpg' | asset_url }}" alt="" class="orgc-logo" width="1672" height="941">
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "About story",
  "tag": "div",
  "class": "page-contain u-container-full page-about_contain",
  "settings": [
    {
      "type": "image_picker",
      "id": "portrait",
      "label": "Portrait image"
