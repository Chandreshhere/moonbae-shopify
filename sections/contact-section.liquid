{% render 'section-class', classes: 'contact-section', pt: section.settings.padding_top, pb: section.settings.padding_bottom %}

<div class="contact_layout u-grid-desktop">
  <div class="contact-imgs_scroll u-column-6">
    {%- assign contact_fallbacks = 'or-contact-01.jpg,or-contact-02.jpg,or-contact-03.jpg,or-contact-04.jpg' | split: ',' -%}
    {%- for block in section.blocks -%}
      {%- assign i = forloop.index0 | modulo: 4 -%}
      <div class="contact-image_wrap" {{ block.shopify_attributes }}>
        {% render 'img', image: block.settings.image, fallback: contact_fallbacks[i], class: 'img-fill' %}
      </div>
    {%- endfor -%}
  </div>
  <div class="contact-info_layout u-column-6">
    <div class="u-container">
      <div class="contact-info">
        <div class="logo-icon_wrap is-contact">{% render 'icon-contact-mark' %}</div>
        <div class="text-style_alt-xlarge">{{ section.settings.heading }}</div>
        <div class="u-vflex-center-top u-gap-1">
          {%- if section.settings.email != blank -%}
            <a h-flip="" href="mailto:{{ section.settings.email }}" class="text-link w-inline-block">
              <div class="body-upper f-5">{{ section.settings.email }}</div>
            </a>
          {%- endif -%}
          {%- if section.settings.phone != blank -%}
            <a h-flip="" href="tel:{{ section.settings.phone | remove: ' ' }}" class="text-link w-inline-block">
              <div class="body-upper f-5">{{ section.settings.phone }}</div>
            </a>
          {%- endif -%}
          {%- if section.settings.signup_label != blank -%}
            <div h-flip="" sub-trigger="" class="text-link">
              <div class="body-upper f-5">{{ section.settings.signup_label }}</div>
            </div>
          {%- endif -%}
          {%- if section.settings.social_url != blank -%}
            <a h-flip="" href="{{ section.settings.social_url }}" target="_blank" class="text-link w-inline-block">
              <div class="body-upper f-5">{{ section.settings.social_label }}</div>
            </a>
          {%- endif -%}
        </div>
      </div>
      {%- if section.settings.show_form -%}
        {%- comment -%}
          A real Shopify contact form — {% form 'contact' %} delivers to the store's
          sender email. Built from the design's own popup/signup classes so it reads
          as part of the site rather than a bolted-on block.
        {%- endcomment -%}
        <div class="contact-form_wrap">
          {% form 'contact', class: 'signup-form' %}
            {%- if form.posted_successfully? -%}
              <div class="popup-success">
                <div class="popup-success_wrap u-text-align-center">
                  <div class="popup-success_icon">{% render 'brand-mono', setting: section.settings.mark_image, variant: 'dark', size: section.settings.mark_size, class: 'is-icon' %}</div>
                  <div class="body-upper">{{ section.settings.form_success }}</div>
                </div>
              </div>
            {%- else -%}
              {%- if form.errors -%}
                <p class="body-upper form-error">{{ form.errors | default_errors }}</p>
              {%- endif -%}

              <label class="u-visually-hidden" for="ContactName">{{ section.settings.form_name_label }}</label>
              <input
                id="ContactName"
                type="text"
                name="contact[name]"
                class="signup-input body-upper is-first"
                value="{{ form.name }}"
                placeholder="{{ section.settings.form_name_label | escape }}"
                autocomplete="name"
                required>

              <label class="u-visually-hidden" for="ContactEmail">{{ section.settings.form_email_label }}</label>
              <input
                id="ContactEmail"
                type="email"
                name="contact[email]"
                class="signup-input body-upper"
                value="{{ form.email }}"
                placeholder="{{ section.settings.form_email_label | escape }}"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                required>

              <label class="u-visually-hidden" for="ContactMessage">{{ section.settings.form_message_label }}</label>
              <textarea
                id="ContactMessage"
                name="contact[body]"
                rows="4"
                class="signup-input body-upper is-last contact-textarea"
                placeholder="{{ section.settings.form_message_label | escape }}"
                required>{{ form.body }}</textarea>

              <div class="popup-submit">
                <button type="submit" class="popup-btn_wrap" aria-label="{{ section.settings.form_button | escape }}">
                  <div class="signup-submit body-upper">{{ section.settings.form_button }}</div>
                  <div class="signup-btn_icon">
                    {% render 'icon-link-arrow', class: 'signup-btn_icon-svg' %}
                    {% render 'icon-link-arrow', class: 'signup-btn_icon-svg is-2' %}
                  </div>
                </button>
              </div>
            {%- endif -%}
          {% endform %}
        </div>
      {%- endif -%}
    </div>
    <div class="contact-footer_el">
      <div class="body-upper f-5">{{ section.settings.footnote }}</div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact",
  "tag": "div",
  "class": "contact-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "Monogram"
    },
    {
      "type": "image_picker",
      "id": "mark_image",
      "label": "Monogram image",
      "info": "Overrides the theme Brand marks monogram for this section only."
    },
    {
      "type": "range",
      "id": "mark_size",
      "label": "Monogram height",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 keeps the design default, which also scales down on mobile. Any other value fixes the height on every screen."
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Contact Us</p>"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "hello@oddritualgolf.com"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "076 207 3387"
    },
    {
      "type": "text",
      "id": "signup_label",
      "label": "Newsletter trigger label",
      "default": "Join our community"
    },
    {
      "type": "text",
      "id": "social_label",
      "label": "Social label",
      "default": "Instagram"
    },
    {
      "type": "url",
      "id": "social_url",
      "label": "Social URL"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote",
      "default": "moonbae ©2025"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 320,
      "step": 4,
      "default": 0,
      "unit": "px",
      "info": "0 keeps the design default."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 320,
      "step": 4,
      "default": 0,
      "unit": "px",
      "info": "0 keeps the design default."
    },
    {
      "type": "header",
      "content": "Enquiry form"
    },
    {
      "type": "checkbox",
      "id": "show_form",
      "label": "Show contact form",
      "default": true,
      "info": "Messages are delivered to the sender email in Settings → Notifications."
    },
    {
      "type": "text",
      "id": "form_name_label",
      "label": "Name field label",
      "default": "Name"
    },
    {
      "type": "text",
      "id": "form_email_label",
      "label": "Email field label",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "form_message_label",
      "label": "Message field label",
      "default": "Message"
    },
    {
      "type": "text",
      "id": "form_button",
      "label": "Submit button",
      "default": "Send"
    },
    {
      "type": "text",
      "id": "form_success",
      "label": "Success message",
      "default": "Thanks — we'll be in touch."
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact",
      "category": "Content",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ],
      "settings": {
        "social_url": "https://www.instagram.com/oddritual.gc/"
      }
    }
  ]
}
{% endschema %}
