{% render 'section-class', classes: 'community-section', attrs: 'nav-dark', pt: section.settings.padding_top, pb: section.settings.padding_bottom %}

{%- assign community_fallbacks = 'or-community-1.jpg,or-community-2.jpg,or-community-3.jpg,or-community-4.jpg' | split: ',' -%}

<div class="community-contain u-container" nav-dark="">
  <div class="section-intro_wrap">
    <div class="split-grid u-grid-desktop">
      <div class="split-col u-column-6">{%- if settings.logo_community != blank -%}<img src="{{ settings.logo_community | image_url: width: 1200 }}" alt="{{ shop.name | escape }}" class="brand-mark" width="{{ settings.logo_community.width }}" height="{{ settings.logo_community.height }}">{%- else -%}{% render 'icon-community-heading' %}{%- endif -%}</div>
    </div>
  </div>

  <div class="split-grid u-grid-desktop"></div>

  <div class="split-grid u-grid-desktop is-giving">
    <div class="split-col u-column-6">
      <div solo-img="" class="small-img_wrap">
        {% render 'img', image: section.settings.giving_image, fallback: 'or-giving.jpg', class: 'img-fill' %}
      </div>
    </div>
    <div class="split-col u-column-5">
      <div solo-trig="" class="community-col">
        <h4 class="body-upper p-contents">{{ section.settings.giving_title }}</h4>
        <div class="u-text-style-small f-4">{{ section.settings.giving_text }}</div>
      </div>
      <div class="community-head">
        <p class="u-text-style-h4">{{ section.settings.list_heading }}</p>
      </div>
    </div>
  </div>

  <div class="community-items_section">
    {%- for block in section.blocks -%}
      {%- assign i = forloop.index0 | modulo: 4 -%}
      <div data-scroll-overlap="" class="community-item" {{ block.shopify_attributes }}>
        <div class="community-h_line{% unless forloop.first %} is-hidden{% endunless %}"></div>
        <div class="split-grid u-grid-desktop">
          <div class="split-col u-column-6">
            <div class="community-layout u-grid-column-2">
              <div class="community-col is-hidden">
                {% render 'orgc-detail', url: block.settings.url, label: block.settings.link_label, target: true, text_class: 'body-upper' %}
              </div>
              <div class="community-col">
                <div class="body-upper"><h4>{{ block.settings.title }}</h4></div>
                <div class="u-text-style-small f-4">{{ block.settings.text }}</div>
              </div>
            </div>
          </div>
          <div class="split-col u-column-6">
            {%- comment -%}
              Blocks used as brand pillars carry no URL. An empty href would still be
              clickable and reload the page, so the wrap becomes a plain div instead.
            {%- endcomment -%}
            {%- if block.settings.url != blank -%}
              <a href="{{ block.settings.url }}" target="_blank" class="community-img-wrap w-inline-block">
                {% render 'img', image: block.settings.image, fallback: community_fallbacks[i], sizes: '(max-width: 695px) 100vw, 695px' %}
                <div class="is-mobile">
                  <div class="orgc-detail body-upper">
                    <div class="detail-text">{{ block.settings.link_label }}</div>
                  </div>
                </div>
              </a>
            {%- else -%}
              <div class="community-img-wrap">
                {% render 'img', image: block.settings.image, fallback: community_fallbacks[i], sizes: '(max-width: 695px) 100vw, 695px' %}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
    <div class="community-item">
      <div class="community-h_line is-hidden"></div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Community",
  "tag": "section",
  "class": "community-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "giving_image",
      "label": "Giving back image"
    },
    {
      "type": "richtext",
      "id": "giving_title",
      "label": "Giving back title",
      "default": "<p>Giving back</p>"
    },
    {
      "type": "richtext",
      "id": "giving_text",
      "label": "Giving back copy",
      "default": "<p>moonbae was never only about clothes. It is the hands that cut and sew, the people who wear it, and the place it is made. We are building the giving side of this deliberately — small, local, and in the open.</p>"
    },
    {
      "type": "text",
      "id": "list_heading",
      "label": "List heading",
      "default": "What we stand for"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 320,
      "step": 4,
      "default": 0,
      "unit": "px",
      "info": "0 keeps the design default."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 320,
      "step": 4,
      "default": 0,
      "unit": "px",
      "info": "0 keeps the design default."
    }
  ],
  "blocks": [
    {
      "type": "partner",
      "name": "Partner",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Name",
          "default": "Fairways to africa"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Website"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Visit Website"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Community",
      "category": "Content",
      "blocks": [
        {
          "type": "partner",
          "settings": {
            "title": "Made slowly",
            "url": "",
            "link_label": "",
            "text": "<p>Small runs, cut and sewn in India. We would rather make fewer pieces properly than many of them in a hurry.</p>"
          }
        },
        {
          "type": "partner",
          "settings": {
            "title": "Chosen by hand",
            "url": "",
            "link_label": "",
            "text": "<p>Cloth picked in person, for how it falls and how it ages. Natural fibres wherever the piece allows it.</p>"
          }
        },
        {
          "type": "partner",
          "settings": {
            "title": "Worn often",
            "url": "",
            "link_label": "",
            "text": "<p>Cuts that sit easy and repeat well — made for the wardrobe you reach for, not the one you photograph.</p>"
          }
        },
        {
          "type": "partner",
          "settings": {
            "title": "Kept long",
            "url": "",
            "link_label": "",
            "text": "<p>Finished to last and easy to mend. The best thing a piece of ours can do is soften, and stay.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
