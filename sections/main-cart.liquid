{% render 'section-class', classes: 'page-cart', attrs: 'nav-dark', pt: section.settings.padding_top, pb: section.settings.padding_bottom %}

{%- if cart.item_count > 0 -%}
  <div class="page-inner">
    <div class="page-intro">
    <div class="shop-contain u-container">
      <div class="shop-intro_wrap">
        <div class="split-grid u-grid-desktop m-flex m-gap_0">
          <div class="split-col u-column-6 m-width_6">
            <div class="body-upper"><p>{{ section.settings.heading }}</p></div>
          </div>
          <div class="split-col u-column-6 u-text-align-right m-push_right m-col_6">
            <p class="body-upper">(&nbsp;{{ cart.item_count }}&nbsp;)</p>
          </div>
        </div>
      </div>

      <form action="{{ routes.cart_url }}" method="post" novalidate class="cart-page_form">
        <div class="footer-titles_layout u-grid-desktop is-desktop">
          <div class="u-column-2"><div class="body-upper"><p>{{ section.settings.col_item }}</p></div></div>
          <div class="u-column-8"><div class="body-upper"><p>{{ section.settings.col_name }}</p></div></div>
          <div class="u-column-2 u-text-align-right"><div class="body-upper"><p>{{ section.settings.col_price }}</p></div></div>
        </div>

        {%- for item in cart.items -%}
          <div class="cart-page_item u-grid-desktop">
            <div class="u-column-2">
              <a href="{{ item.url }}" class="checkout-img_wrap w-inline-block">
                {%- if item.image -%}
                  <img src="{{ item.image | image_url: width: 400 }}" alt="{{ item.title | escape }}" class="checkout-img" width="{{ item.image.width }}" height="{{ item.image.height }}">
                {%- endif -%}
              </a>
            </div>
            <div class="u-column-8">
              <a href="{{ item.url }}" class="footer-link is-alt w-inline-block">
                <p class="body-upper">{{ item.product.title }}</p>
              </a>
              {%- for option in item.options_with_values -%}
                <p class="body-upper text-grey">{{ option.name }}: {{ option.value }}</p>
              {%- endfor -%}
              <input class="w-commerce-commercecartquantity" type="number" min="0" name="updates[]" value="{{ item.quantity }}" aria-label="{{ 'cart.general.quantity' | t }}">
              <a href="{{ item.url_to_remove }}" class="remove_contain">
                <div class="field_copy">{{ settings.cart_remove_nav_label }}</div>
              </a>
            </div>
            <div class="u-column-2 u-text-align-right">
              <p class="body-upper">{{ item.final_line_price | money }}</p>
            </div>
          </div>
        {%- endfor -%}

        <div class="cart-page_footer u-grid-desktop">
          <div class="u-column-6"></div>
          <div class="u-column-6">
            <div class="cart-line_item">
              <div class="field_copy">{{ settings.cart_subtotal_label }}</div>
              <div class="body-upper">{{ cart.total_price | money_with_currency }}</div>
            </div>
            <div class="cart-line_item">
              <div class="field_copy">{{ settings.cart_shipping_label }}</div>
              <div class="body-upper">{{ settings.cart_shipping_note }}</div>
            </div>
            <div class="checkout-actions">
              <button type="submit" name="update" class="checkout-button body-upper is-secondary">{{ section.settings.update_label }}</button>
              <button type="submit" name="checkout" class="checkout-button body-upper">{{ settings.cart_checkout_label }}</button>
            </div>
          </div>
        </div>
      </form>
    </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Cart",
  "tag": "div",
  "class": "page-cart",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Cart"
    },
    {
      "type": "text",
      "id": "col_item",
      "label": "Column 1",
      "default": "Item"
    },
    {
      "type": "text",
      "id": "col_name",
      "label": "Column 2",
      "default": "Name"
    },
    {
      "type": "text",
      "id": "col_price",
      "label": "Column 3",
      "default": "Price"
    },
    {
      "type": "text",
      "id": "update_label",
      "label": "Update button",
      "default": "Update"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 320,
      "step": 4,
      "default": 0,
      "unit": "px",
      "info": "0 keeps the design default."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 320,
      "step": 4,
      "default": 0,
      "unit": "px",
      "info": "0 keeps the design default."
    }
  ]
}
{% endschema %}
