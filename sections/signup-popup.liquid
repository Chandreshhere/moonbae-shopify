{% render 'section-class', id: 'shopify-section-signup-popup', classes: 'signup-popup' %}

<div data-cursor="close" class="signup-bg"></div>
<div class="signup-box u-grid-desktop">
  <div class="signup-col u-column-6">
    <div class="signup-img_wrap">
      {% render 'img', image: section.settings.image, fallback: 'or-signup.jpg', class: 'img-fill' %}
    </div>
  </div>
  <div class="signup-col u-column-6 m-stretch">
    <div class="signup-content">
      <div class="signup-top">
        <div class="signup-head">
          <div class="body-upper p-contents">{{ section.settings.heading }}</div>
        </div>
        <div class="signup-close" role="button" tabindex="0" aria-label="{{ section.settings.close_label | escape }}">
          <img src="{{ 'or-signup-close.svg' | asset_url }}" alt="" class="close-svg" loading="auto" width="22" height="22">
        </div>
      </div>

      {%- if section.settings.body != blank -%}
        <div class="signup-body u-text-style-small f-5">{{ section.settings.body }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="signup-list">
          {%- for block in section.blocks -%}
            <li class="body-upper" {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="signup-bot">
        <div class="is-form">
          {% render 'newsletter-form', id: 'popup', variant: 'popup' %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Signup popup",
  "tag": "div",
  "class": "signup-popup",
  "max_blocks": 4,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>Become part of the Odd ritual community.</p>" },
    {
      "type": "richtext", "id": "body", "label": "Supporting copy",
      "default": "<p>New drops, old swings and the odd bit of nonsense from the course. No spam — just the good stuff, now and then.</p>"
    },
    { "type": "text", "id": "close_label", "label": "Close button label", "default": "Close" },
    { "type": "header", "content": "Behaviour" },
    { "type": "checkbox", "id": "auto_open", "label": "Open automatically on first visit", "default": true },
    { "type": "range", "id": "delay", "label": "Delay (seconds)", "min": 0, "max": 30, "step": 1, "default": 10 }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Bullet",
      "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Early access to new drops" } ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "point", "settings": { "text": "Early access to new drops" } },
      { "type": "point", "settings": { "text": "Members-only releases" } },
      { "type": "point", "settings": { "text": "Stories from the course" } }
    ]
  }
}
{% endschema %}
