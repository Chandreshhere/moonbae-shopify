{%- comment -%}
  Announcement bar. Rendered first inside the Barba container, above the header,
  so it arrives and leaves with the page it belongs to — which is what lets it
  be limited to the home page. Anything outside that container is never swapped,
  so a bar rendered once would have stayed on screen for the rest of the visit.

  Rotates between messages only when there is more than one.
{%- endcomment -%}
{%- liquid
  assign messages = section.blocks | where: 'type', 'message'
  assign show_here = false
  if section.settings.show_on == 'all'
    assign show_here = true
  elsif template.name == 'index'
    assign show_here = true
  endif
-%}
{%- if messages.size > 0 and section.settings.enabled and show_here -%}
  <div class="announcement-bar body-upper"
       style="--announcement-bg: {{ section.settings.bg }}; --announcement-fg: {{ section.settings.fg }};"
       data-announcement{% if section.settings.style == 'marquee' %} data-announcement-marquee{% elsif messages.size > 1 %} data-announcement-rotate="{{ section.settings.rotate_seconds }}"{% endif %}>
    {%- if section.settings.style == 'marquee' -%}
      {%- comment -%}
        Two identical runs side by side, the pair translated by exactly -50%:
        as the first scrolls out the second is already in its place, so the
        loop has no seam. Duplicated in markup rather than cloned in JS so it
        is right on the first frame.
      {%- endcomment -%}
      <div class="announcement-bar_marquee" style="--announcement-speed: {{ section.settings.speed }}s;">
        {%- for run in (1..2) -%}
          <div class="announcement-bar_run" {% if run == 2 %}aria-hidden="true"{% endif %}>
            {%- for block in messages -%}
              <span class="announcement-bar_unit" {% if run == 1 %}{{ block.shopify_attributes }}{% endif %}>
                {%- if block.settings.url != blank -%}
                  <a href="{{ block.settings.url }}">{{ block.settings.text }}</a>
                {%- else -%}
                  {{ block.settings.text }}
                {%- endif -%}
              </span>
              <span class="announcement-bar_sep" aria-hidden="true">{{ section.settings.separator }}</span>
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="announcement-bar_track">
        {%- for block in messages -%}
          <div class="announcement-bar_item{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.url != blank -%}
              <a href="{{ block.settings.url }}">{{ block.settings.text }}</a>
            {%- else -%}
              <span>{{ block.settings.text }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show the bar",
      "default": true
    },
    {
      "type": "select",
      "id": "show_on",
      "label": "Show on",
      "info": "The bar sits above the header and pushes the page down by its own height, so it is worth keeping for the pages it earns its place on.",
      "default": "home",
      "options": [
        {
          "value": "home",
          "label": "Home page only"
        },
        {
          "value": "all",
          "label": "Every page"
        }
      ]
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "default": "marquee",
      "options": [
        {
          "value": "marquee",
          "label": "Scrolling marquee"
        },
        {
          "value": "rotate",
          "label": "One at a time"
        }
      ]
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Seconds for one full pass",
      "min": 10,
      "max": 80,
      "step": 5,
      "default": 30,
      "info": "Higher is slower. Marquee only."
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Separator",
      "default": "\u25c6"
    },
    {
      "type": "range",
      "id": "rotate_seconds",
      "label": "Seconds per message",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 5,
      "info": "Only applies when there is more than one message."
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#050fff"
    },
    {
      "type": "color",
      "id": "fg",
      "label": "Text",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free shipping on orders over \u20b91,599"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 5,
  "default": {
    "settings": {},
    "blocks": [
      {
        "type": "message",
        "settings": {
          "text": "Free shipping over \u20b91,599"
        }
      },
      {
        "type": "message",
        "settings": {
          "text": "Made to order in India \u2014 dispatched in 2\u20134 business days"
        }
      },
      {
        "type": "message",
        "settings": {
          "text": "Cut and sewn in small runs, never warehoused"
        }
      },
      {
        "type": "message",
        "settings": {
          "text": "Replaced free if it arrives damaged or wrong"
        }
      },
      {
        "type": "message",
        "settings": {
          "text": "Dressed for the quiet hours"
        }
      }
    ]
  }
}
{% endschema %}
