{% render 'section-class', classes: 'page-single u-container', attrs: 'nav-dark', pt: section.settings.padding_top, pb: section.settings.padding_bottom %}

{%- assign current_variant = product.selected_or_first_available_variant -%}

<div class="single-layout">
  <div class="single-grid u-grid-desktop">
    <div class="single-img_col u-column-7">
      <div class="single-featured_img">
        {%- if product.featured_media -%}
          {%- comment -%}
            width/height matter here beyond tidiness: with no intrinsic size the
            browser reserves nothing, so until the file arrives the alt text
            sprawls across an empty box — which is what "White Baby Tee Front
            Design" appearing as words on the page actually was.
          {%- endcomment -%}
          <img
            alt="{{ product.featured_media.alt | default: product.title | escape }}"
            src="{{ product.featured_media | image_url: width: 1920 }}"
            width="{{ product.featured_media.width }}"
            height="{{ product.featured_media.height }}"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="img-contain product-zoomable"
            data-lightbox-src="{{ product.featured_media | image_url: width: 2400 }}"
            data-lightbox-alt="{{ product.featured_media.alt | default: product.title | escape }}"
            role="button" tabindex="0"
            data-commerce-type="variation-image"
            srcset="{{ product.featured_media | image_url: width: 500 }} 500w, {{ product.featured_media | image_url: width: 800 }} 800w, {{ product.featured_media | image_url: width: 1200 }} 1200w, {{ product.featured_media | image_url: width: 1600 }} 1600w, {{ product.featured_media | image_url: width: 1920 }} 1920w"
            sizes="(max-width: 991px) 100vw, 58vw">
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'img-contain' }}
        {%- endif -%}
      </div>

      {%- if product.media.size > 1 -%}
        {%- comment -%}
          No data-commerce-type here: the cart bridge tries to take ownership of
          a "more-images" list and render it from a Webflow template, finds none
          because Liquid has already rendered the real media, and logs
          "Invalid Template More Images" on every product page.
        {%- endcomment -%}
        <div class="single-more_imgs w-dyn-list">
          <div role="list" class="split-grid u-grid-desktop is-product_slider w-dyn-items">
            {%- for media in product.media offset: 1 -%}
              <div role="listitem" class="split-col u-column-6 w-dyn-item">
                <div class="product-img_wrap">
                  <img alt="{{ media.alt | default: product.title | escape }}" src="{{ media | image_url: width: 1200 }}"
                       width="{{ media.width }}" height="{{ media.height }}" loading="lazy" decoding="async" class="img-contain product-zoomable"
                       data-lightbox-src="{{ media | image_url: width: 2400 }}" data-lightbox-alt="{{ media.alt | default: product.title | escape }}"
                       role="button" tabindex="0"
                       srcset="{{ media | image_url: width: 500 }} 500w, {{ media | image_url: width: 800 }} 800w, {{ media | image_url: width: 1200 }} 1200w"
                       sizes="(max-width: 991px) 50vw, 29vw">
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>

    <div class="single-content_col u-column-5 m-col_12">
      <div class="single-product_options">
        {%- comment -%}
          Breadcrumb. Matches the BreadcrumbList structured data already in
          meta-tags, so what a visitor sees and what Google reads agree.
        {%- endcomment -%}
        {%- if section.settings.show_breadcrumb -%}
          {%- assign parent = product.collections.first -%}
          <nav class="product-breadcrumb body-upper" aria-label="Breadcrumb">
            <a href="{{ routes.root_url }}">{{ 'general.breadcrumb.home' | t | default: 'Home' }}</a>
            <span aria-hidden="true">/</span>
            {%- if parent -%}
              <a href="{{ parent.url }}">{{ parent.title }}</a>
              <span aria-hidden="true">/</span>
            {%- endif -%}
            <span aria-current="page">{{ product.title }}</span>
          </nav>
        {%- endif -%}

        <div class="single-product_head">
          <div class="split-grid u-grid-desktop">
            <div class="split-col u-column-8 m-col_12">
              <h1 class="product-title">{{ product.title }}</h1>
              {% render 'product-code', product: product, tag: 'p', class: 'u-text-style-h4 f-5', brackets: false %}
            </div>
            <div class="split-col u-column-4 u-text-align-right m-align_left">
              {%- liquid
                comment
                  The cart bridge rewrites the price itself when the size
                  changes. The struck-through Compare-at price, the % off and
                  the saving sit beside it and follow it from the map below
                  (scripts-2026.js, [data-compare-map]).
                endcomment
                assign cv_was = current_variant.compare_at_price | default: 0
                assign cv_off = 0
                if settings.show_discount != false and cv_was > current_variant.price
                  assign cv_off = cv_was | minus: current_variant.price | times: 100.0 | divided_by: cv_was | round
                endif
              -%}
              <div data-commerce-type="variation-price" class="product-title price{% if cv_off > 0 %} is-on-sale{% endif %}" data-product-price>{{ current_variant.price | money }}</div>
              <div class="product-compare body-upper" data-product-compare{% if cv_off == 0 %} hidden{% endif %}>
                <s class="price-was"><span class="u-visually-hidden">Regular price </span><span data-compare-was>{% if cv_off > 0 %}{{ cv_was | money }}{% endif %}</span></s>
                <span class="price-off"><span data-compare-off>{{ cv_off }}</span>% off</span>
                <span class="price-save">You save <span data-compare-save>{% if cv_off > 0 %}{{ cv_was | minus: current_variant.price | money }}{% endif %}</span></span>
              </div>
              <script type="application/json" data-compare-map data-form="#product_form_{{ product.id }}">
                [
                {%- for v in product.variants -%}
                  {%- liquid
                    assign w = v.compare_at_price | default: 0
                    assign o = 0
                    if settings.show_discount != false and w > v.price
                      assign o = w | minus: v.price | times: 100.0 | divided_by: w | round
                    endif
                    assign o1 = v.option1 | default: '' | downcase
                    assign o2 = v.option2 | default: '' | downcase
                    assign o3 = v.option3 | default: '' | downcase
                    assign save = w | minus: v.price
                  -%}
                  {"id": {{ v.id }}, "available": {{ v.available | json }}, "o": [{{ o1 | json }}, {{ o2 | json }}, {{ o3 | json }}], "off": {{ o }}, "was": {{ w | money | json }}, "save": {{ save | money | json }}}{% unless forloop.last %},{% endunless %}
                {%- endfor -%}
                ]
              </script>
            </div>
          </div>
          <div class="product-description_wrap u-text-style-small f-5">
            {{ product.description }}
          </div>

        </div>

        {%- comment -%}
          The buy area sits straight under the title and price, ahead of the
          accordions, so the size and the buttons are the first thing after the
          price rather than pinned to the bottom of the column.
        {%- endcomment -%}
        {%- liquid
          comment
            Size chart: the first Size chart block whose "Match" text appears in
            this product's SKU or title. Unitee's SKUs name the blank
            (240-offwh-boxy-tee-u-…, 360-bl-hood-u-…), so each garment finds its
            own chart and a product added later needs nothing set on it.
          endcomment
          assign size_chart = nil
          assign chart_hay = product.selected_or_first_available_variant.sku | append: ' ' | append: product.title | downcase
          for block in section.blocks
            if block.type != 'size_chart' or block.settings.match == blank
              continue
            endif
            assign chart_keys = block.settings.match | downcase | split: ','
            for k in chart_keys
              assign k = k | strip
              if k != blank and chart_hay contains k
                assign size_chart = block
                break
              endif
            endfor
            if size_chart
              break
            endif
          endfor
        -%}
        <div class="add-to-cart_single">
          {%- comment -%}
            Written out rather than using {% form 'product' %}: the reference markup needs
            data-node-type on the form element, and a hyphenated key is not valid Liquid in a tag
            argument list. These are the exact fields Shopify's product form emits.
          {%- endcomment -%}
          <form method="post" action="{{ routes.cart_add_url }}" id="product_form_{{ product.id }}" accept-charset="UTF-8" class="w-commerce-commerceaddtocartform single-product_actions" enctype="multipart/form-data" data-node-type="commerce-add-to-cart-form">
            <input type="hidden" name="form_type" value="product">
            <input type="hidden" name="utf8" value="✓">

            {%- comment -%}
              Udesly's add-to-cart class does JSON.parse(form.querySelector('script').textContent)
              in its constructor. Without this block it throws, the form is never bound, and
              Add to Cart falls back to a full page POST instead of the drawer. Option values
              are lower-cased to match the pill group's data-option-name and the select values.
            {%- endcomment -%}
            <script type="application/json" data-type="product-variations-data">
              [
              {%- for v in product.variants -%}
                {%- capture v_weight -%}{% if v.weight %}{{ v.weight | weight_with_unit }}{% endif %}{%- endcapture -%}
                {%- assign o1 = v.option1 | default: v.options[0] | default: '' -%}
                {%- assign o2 = v.option2 | default: v.options[1] | default: '' -%}
                {%- assign o3 = v.option3 | default: v.options[2] | default: '' -%}
                {
                  "id": {{ v.id | append: '' | json }},
                  "weight": {{ v_weight | strip | json }},
                  "length": "", "height": "", "width": "",
                  "unit_price": {{ v.unit_price_measurement.reference_value | default: '' | append: '' | json }},
                  "available": {{ v.available | json }},
                  "sku": {{ v.sku | default: '' | json }},
                  "barcode": {{ v.barcode | default: '' | json }},
                  "price": {{ v.price | money | json }},
                  "option1": {{ o1 | downcase | json }},
                  "option2": {{ o2 | downcase | json }},
                  "option3": {{ o3 | downcase | json }},
                  "featured_image": {% if v.image %}{{ v.image | image_url: width: 1920 | json }}{% else %}""{% endif %},
                  "more_images": null
                }{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
              ]
            </script>
            {%- unless product.has_only_default_variant -%}
              <div data-node-type="add-to-cart-option-list" class="size-variation_btn">
                {%- for option in product.options_with_values -%}
                  <fieldset data-node-type="add-to-cart-option" class="option">
                    <select data-node-type="add-to-cart-option-select" class="w-select" style="display: none;" name="option{{ option.position }}" data-option-index="{{ option.position }}">
                      {%- for value in option.values -%}
                        <option value="{{ value | downcase | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value }}</option>
                      {%- endfor -%}
                    </select>
                    {%- liquid
                      assign opt_idx = option.position | minus: 1
                      assign chosen_value = current_variant.options[opt_idx]
                    -%}
                    <div data-node-type="add-to-cart-option-pill-group" class="size-button_group w-commerce-commerceaddtocartoptionpillgroup" aria-label="option{{ option.position }}">
                      {%- for value in option.values -%}
                        <div data-node-type="add-to-cart-option-pill" class="size-button w-commerce-commerceaddtocartoptionpill{% if value == chosen_value %} w--ecommerce-pill-selected{% endif %}" data-option-name="{{ value | downcase | escape }}">
                          <div data-node-type="block" class="body-upper size-choice">{{ value }}</div>
                        </div>
                      {%- endfor -%}
                    </div>
                    {%- assign chosen = chosen_value | default: '&nbsp;' -%}
                    <div data-node-type="block" class="size-toggle">
                      <div data-node-type="block" class="body-upper">
                        {{ option.name }}:
                        <span data-node-type="span" class="size-selected">{{ chosen }}</span>
                      </div>
                      {%- if size_chart and forloop.first -%}
                        <button type="button" class="size-chart_link body-upper" data-size-chart-open aria-haspopup="dialog">{{ section.settings.size_chart_label | default: 'Size chart' }}</button>
                      {%- endif -%}
                    </div>
                  </fieldset>
                {%- endfor -%}
              </div>
            {%- endunless -%}

            <input type="submit"
                   data-node-type="commerce-add-to-cart-button"
                   data-loading-text="{{ section.settings.adding_label | escape }}"
                   aria-busy="false"
                   aria-haspopup="dialog"
                   class="w-commerce-commerceaddtocartbutton add-to-cart_btn"
                   value="{{ section.settings.add_label | escape }}"
                   {% unless current_variant.available %}disabled{% endunless %}>
            {%- if section.settings.buy_now_label != blank -%}
              {%- comment -%}
                Buy now goes straight to checkout with this item. Razorpay Magic
                Checkout takes over any button.shopify-payment-button__button--unbranded
                inside a form posting to /cart/add, so with its app embed on this
                opens Magic Checkout at the address step; without it,
                scripts-2026.js ([data-buy-now]) adds the item and opens Shopify's
                checkout, whose first page is the address.
              {%- endcomment -%}
              <button type="button"
                      class="buy-now_btn shopify-payment-button__button shopify-payment-button__button--unbranded"
                      data-buy-now
                      {% unless current_variant.available %}disabled{% endunless %}>{{ section.settings.buy_now_label }}</button>
            {%- endif -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
            <input type="hidden" name="product-id" value="{{ product.id }}">
          </form>

          {%- if size_chart -%}
            {%- liquid
              assign chart_cols = size_chart.settings.columns | split: ','
              assign chart_rows = size_chart.settings.rows | newline_to_br | split: '<br />'
              comment
                Only the sizes this product is sold in, so a tee offered in
                S to XL does not list a 2XL. XXL and 2XL count as the same.
              endcomment
              assign sold_sizes = ''
              for v in product.options_with_values.first.values
                assign vv = v | upcase | replace: '2XL', 'XXL' | strip
                assign sold_sizes = sold_sizes | append: '|' | append: vv | append: '|'
              endfor
            -%}
            <dialog class="size-chart" data-size-chart data-lenis-prevent aria-labelledby="size-chart-title-{{ section.id }}" {{ size_chart.shopify_attributes }}>
              <div class="size-chart_head">
                <h2 class="size-chart_title body-upper" id="size-chart-title-{{ section.id }}">{{ size_chart.settings.title }}</h2>
                <button type="button" class="size-chart_close body-upper" data-size-chart-close aria-label="Close size chart">Close</button>
              </div>
              <div class="size-chart_scroll">
                <table class="size-chart_table">
                  <thead>
                    <tr>
                      {%- for c in chart_cols -%}<th scope="col">{{ c | strip }}</th>{%- endfor -%}
                    </tr>
                  </thead>
                  <tbody>
                    {%- for row in chart_rows -%}
                      {%- assign cells = row | strip | split: ',' -%}
                      {%- if cells.size == 0 -%}{%- continue -%}{%- endif -%}
                      {%- assign key = cells.first | strip | upcase | replace: '2XL', 'XXL' -%}
                      {%- assign needle = '|' | append: key | append: '|' -%}
                      {%- unless sold_sizes contains needle -%}{%- continue -%}{%- endunless -%}
                      <tr>
                        {%- for cell in cells -%}
                          {%- if forloop.first -%}<th scope="row">{{ cell | strip }}</th>{%- else -%}<td>{{ cell | strip }}</td>{%- endif -%}
                        {%- endfor -%}
                      </tr>
                    {%- endfor -%}
                  </tbody>
                </table>
              </div>
              {%- if size_chart.settings.note != blank -%}
                <p class="size-chart_note">{{ size_chart.settings.note }}</p>
              {%- endif -%}
            </dialog>
          {%- endif -%}

          <div style="display:{% if current_variant.available %}none{% else %}block{% endif %}" class="w-commerce-commerceaddtocartoutofstock error-state" tabindex="0">
            <div class="body-upper">{{ section.settings.sold_out_text }}</div>
          </div>
          <div aria-live="assertive" data-node-type="commerce-add-to-cart-error" style="display:none" class="w-commerce-commerceaddtocarterror error-state">
            <div data-node-type="commerce-add-to-cart-error" class="body-upper"
                 data-w-add-to-cart-quantity-error="{{ settings.cart_error_text | escape }}"
                 data-w-add-to-cart-general-error="Something went wrong when adding this item to the cart."
                 data-w-add-to-cart-mixed-cart-error="You can’t purchase another product with a subscription."
                 data-w-add-to-cart-buy-now-error="Something went wrong when trying to purchase this item."
                 data-w-add-to-cart-checkout-disabled-error="Checkout is disabled on this store."
                 data-w-add-to-cart-select-all-options-error="Please select an option in each set.">{{ settings.cart_error_text }}</div>
          </div>
        </div>

        {%- if section.blocks.size > 0 -%}
          <div class="product-toggle_section">
            {%- for block in section.blocks -%}
              {%- assign mf = product.metafields[block.settings.metafield_namespace][block.settings.metafield_key] -%}
              {%- assign content = block.settings.text -%}
              {%- if mf != blank -%}{%- assign content = mf | metafield_tag -%}{%- endif -%}
              {%- if content != blank -%}
                <div class="product-accordion" {{ block.shopify_attributes }}>
                  <div class="product-toggle">
                    <div class="product-info_title_block">
                      <div class="body-upper">{{ block.settings.title }}</div>
                    </div>
                    <div class="accordion-dropdown">
                      <div class="accordion-dropdown_content">
                        <div class="u-text-style-small f-5">
                          <div class="w-richtext" metafield-wrapper="pageItem">{{ content }}</div>
                        </div>
                      </div>
                    </div>
                    <div class="toggle-icon">
                      <div class="toggle-line"></div>
                      <div class="toggle-line is-vert"></div>
                    </div>
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

      </div>
    </div>
  </div>
</div>

{%- comment -%}
  Specs and benefits sit below the buy area rather than beside it. The info
  column is a fixed 100svh sticky panel with the add-to-cart pinned to its
  bottom by margin-top:auto, so anything added inside it pushes the button
  past the bottom edge and out of sight.
{%- endcomment -%}
{%- assign has_specs = section.blocks | where: 'type', 'spec' -%}
{%- assign has_benefits = section.blocks | where: 'type', 'benefit' -%}
{%- if has_specs.size > 0 or has_benefits.size > 0 -%}
  <div class="product-detail_band u-container">
  {%- comment -%}
    Specs and benefits. Each reads a product metafield first and falls
    back to the value typed on the block, so one block can serve the
    whole catalogue and still say something different per product.
  {%- endcomment -%}
  {%- liquid
    assign specs = section.blocks | where: 'type', 'spec'
    comment
      What the garment is, read off the Unitee SKU (360-bl-hood-u-…: GSM,
      colour, blank). One Weight block saying 220 GSM was wrong for every
      hoodie and boxy tee. Facts are Unitee's own catalogue: fabric per
      blank, GSM from the SKU. A product metafield still wins, and a blank
      not listed here falls back to the value typed on the block.
    endcomment
    assign sku = product.selected_or_first_available_variant.sku | downcase
    assign sku_gsm = sku | split: '-' | first | plus: 0
    assign fact_weight = ''
    if sku_gsm > 0
      assign fact_weight = sku_gsm | append: ' GSM'
    endif
    assign fact_comp = ''
    assign fact_fit = ''
    if sku contains '-hood-'
      assign fact_comp = '100% cotton fleece'
      assign fact_fit = 'Boxy'
    elsif sku contains 'baby-tee'
      assign fact_comp = '95% cotton, 5% lycra'
      assign fact_fit = 'Fitted'
    elsif sku contains 'boxy-tee'
      assign fact_comp = '100% French terry cotton'
      assign fact_fit = 'Boxy'
    elsif sku contains '-waf-'
      assign fact_comp = 'Cotton blend waffle knit'
      assign fact_fit = 'Oversized'
    elsif sku contains 'ovr-tee'
      assign fact_fit = 'Oversized'
      if sku_gsm == 240
        assign fact_comp = '100% French terry cotton'
      elsif sku_gsm > 0
        assign fact_comp = '100% cotton'
      endif
    endif
  -%}
  {%- if specs.size > 0 -%}
    <dl class="product-specs">
      {%- for block in specs -%}
        {%- liquid
          assign mf = product.metafields[block.settings.metafield_namespace][block.settings.metafield_key]
          assign fact = ''
          assign spec_label = block.settings.label | downcase | strip
          case spec_label
            when 'composition', 'fabric', 'material'
              assign fact = fact_comp
            when 'weight', 'gsm'
              assign fact = fact_weight
            when 'fit'
              assign fact = fact_fit
          endcase
          assign value = mf | default: fact | default: block.settings.value
        -%}
        {%- if value != blank -%}
          <div class="product-spec" {{ block.shopify_attributes }}>
            <dt class="body-upper product-spec_label">{{ block.settings.label }}</dt>
            <dd class="body-upper product-spec_value">{{ value }}</dd>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </dl>
  {%- endif -%}

  {%- assign benefits = section.blocks | where: 'type', 'benefit' -%}
  {%- if benefits.size > 0 -%}
    <div class="product-benefits">
      {%- if section.settings.benefits_heading != blank -%}
        <p class="body-upper product-benefits_heading">
          {{ section.settings.benefits_heading }} {{ current_variant.price | money }}
        </p>
      {%- endif -%}
      <ul class="product-benefits_list" role="list">
        {%- for block in benefits -%}
          {%- if block.settings.title != blank -%}
            <li class="product-benefit" {{ block.shopify_attributes }}>
              <span class="product-benefit_title body-upper">{{ block.settings.title }}</span>
              {%- if block.settings.text != blank -%}
                <span class="product-benefit_text">{{ block.settings.text }}</span>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
  </div>
{%- endif -%}

{%- comment -%}
  More products, under the one being looked at.

  Three sources, in order: a collection the merchant picks, the collection this
  product is in, and failing both, the catalogue. The last one matters — the
  row used to render nothing at all for a product that had not been put in a
  collection yet, which is every product on a shop that is still being set up,
  and a dead end under a product page is a lost sale rather than a tidy blank.
{%- endcomment -%}
{%- liquid
  assign related = collections[section.settings.related_collection].products
  if related.size == 0
    assign related = product.collections.first.products
  endif
  if related.size == 0
    assign related = collections.all.products
  endif

  comment
    Counted before rendering, because a row that turns out to hold only the
    product you are already looking at should not print a heading over nothing.
  endcomment
  assign available = 0
  for item in related
    if item.id != product.id
      assign available = available | plus: 1
    endif
  endfor
  comment
    A collection that holds only this product counts as nothing to show, so
    fall back to the whole catalogue in that case too.
  endcomment
  if available == 0
    assign related = collections.all.products
    for item in related
      if item.id != product.id
        assign available = available | plus: 1
      endif
    endfor
  endif
-%}
{%- if available > 0 -%}
  <div class="single-product-col_wrap w-dyn-list" udy-collection="product">
    {%- if section.settings.related_heading != blank -%}
      <div class="single-product-heading u-container">
        <p class="body-upper">{{ section.settings.related_heading }}</p>
      </div>
    {%- endif -%}
    <div role="list" class="single-product-col_list u-grid-desktop w-dyn-items">
      {%- assign shown = 0 -%}
      {%- for item in related -%}
        {%- if item.id != product.id and shown < section.settings.related_count -%}
          {%- assign shown = shown | plus: 1 -%}
          {% render 'product-card-grid', product: item, item_class: 'single-product-col_item u-column-4' %}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{%- comment -%}
  Sticky mobile add-to-cart. On a phone the real button scrolls away under the
  description and never comes back. This bar mirrors it once it leaves the
  viewport and clicks the real button, so every add still goes through the
  one form and the cart drawer. Not rendered at all when the variant is sold
  out — a sticky "sold out" bar would only get in the way.
{%- endcomment -%}
{%- if current_variant.available -%}
  <div class="sticky-atc" data-sticky-atc="#product_form_{{ product.id }}" aria-hidden="true">
    <div class="sticky-atc_info">
      <div class="body-upper sticky-atc_title">{{ product.title }}</div>
      <div class="sticky-atc_price">
        <div class="body-upper{% if cv_off > 0 %} is-on-sale{% endif %}" data-sticky-atc-price>{{ current_variant.price | money }}</div>
        <s class="price-was body-upper" data-sticky-atc-was{% if cv_off == 0 %} hidden{% endif %}>{% if cv_off > 0 %}{{ cv_was | money }}{% endif %}</s>
      </div>
    </div>
    <button type="button" class="sticky-atc_btn body-upper" data-sticky-atc-btn tabindex="-1">{{ section.settings.add_label }}</button>
  </div>
{%- endif -%}

{%- comment -%}
  Full-screen image viewer. Filled by scripts-2026.js from the page's own
  data-lightbox-src images, so the merchant's media order is the order here.
{%- endcomment -%}
<div class="product-lightbox" data-lightbox hidden aria-modal="true" role="dialog" aria-label="{{ product.title | escape }}">
  <button type="button" class="product-lightbox_close" data-lightbox-close aria-label="Close">&#215;</button>
  <button type="button" class="product-lightbox_arrow is-prev" data-lightbox-prev aria-label="Previous image">&#8592;</button>
  <div class="product-lightbox_stage" data-lightbox-stage>
    <img class="product-lightbox_img" data-lightbox-img alt="">
  </div>
  <button type="button" class="product-lightbox_arrow is-next" data-lightbox-next aria-label="Next image">&#8594;</button>
  <p class="product-lightbox_count body-upper" data-lightbox-count></p>
</div>

