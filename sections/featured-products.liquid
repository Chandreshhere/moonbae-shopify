{% render 'section-class', classes: 'page-contain u-container is-section', attrs: 'nav-dark', pt: section.settings.padding_top, pb: section.settings.padding_bottom %}
<div class="product-draggable_wrap is-home">

{%- liquid
  comment
    Products come straight from the Online Store — a collection when one is
    picked, otherwise everything the store sells. Nothing is hand-picked, so a
    product added in Shopify (or pushed in by an app such as Qikink) shows up
    here on its own, as soon as it is published to the Online Store channel.

    The vendor setting narrows that further. Print-on-demand apps stamp every
    product they create with the same vendor, so typing it here shows only
    those and leaves the rest of the catalogue out.
  endcomment
  assign limit = section.settings.products_limit
  assign vendor_filter = section.settings.vendor | strip | downcase

  if section.settings.collection != blank
    assign products_list = section.settings.collection.products
  else
    assign products_list = collections.all.products
  endif
-%}

{%- comment -%}
  Built before the marquee maths: the vendor filter means the number of cards
  that actually render is not known from any count Shopify hands us.
{%- endcomment -%}
{%- capture cards_html -%}
  {%- assign shown = 0 -%}
  {%- for product in products_list -%}
    {%- if shown >= limit -%}{%- break -%}{%- endif -%}
    {%- assign this_vendor = product.vendor | strip | downcase -%}
    {%- if vendor_filter != blank and this_vendor != vendor_filter -%}{%- continue -%}{%- endif -%}
    {% render 'product-card', product: product %}
    {%- assign shown = shown | plus: 1 -%}
  {%- endfor -%}
{%- endcapture -%}

{%- liquid
  assign render_count = shown

  comment
    The marquee needs two identical tracks to loop seamlessly, so it shows
    every product at least twice — fine across a full catalogue, but with a
    handful it just reads as the same items over and over. Below the threshold
    the section drops the marquee entirely and lays the products out once.
  endcomment
  assign is_marquee = false
  assign repeat = 1
  if render_count >= 6
    assign is_marquee = true
    if render_count < 12
      assign repeat = 12 | divided_by: render_count
      assign covered = repeat | times: render_count
      if covered < 12
        assign repeat = repeat | plus: 1
      endif
    endif
  endif
-%}

<div class="or-info">
  <div class="u-text-align-center">
    <div class="text-style_alt-large">{{ section.settings.eyebrow }}</div>
  </div>
</div>

{%- if request.design_mode and render_count == 0 -%}
  <div class="u-text-align-center" style="padding: 1rem; margin: 0 auto; max-width: 44rem; border: 1px solid currentColor;">
    <p class="body-upper">
      No products to show here yet.
      {%- if section.settings.vendor != blank %}
        Nothing matches the vendor “{{ section.settings.vendor }}”. Check the spelling against the product's Vendor field in Shopify admin, or clear the box to show every product.
      {%- elsif section.settings.collection != blank %}
        Nothing in the “{{ section.settings.collection.title }}” collection is visible to the storefront. A product only counts here when its status is Active <em>and</em> it is published to the Online Store sales channel — a draft product still appears in the collection in admin, but not on the site. Or clear the collection to show every product.
      {%- else %}
        Add a product in Shopify and publish it to the Online Store sales channel. Products created by apps such as Qikink are not published there by default.
      {%- endif %}
      This notice is only visible in the theme editor.
    </p>
  </div>
{%- endif -%}

{%- if is_marquee -%}
  <div product-slider="" class="product-draggable_el">
    {%- comment -%} Two identical tracks so the marquee can loop seamlessly. {%- endcomment -%}
    {%- for pass in (1..2) -%}
      <div class="product-slider w-dyn-list" udy-collection="product">
        <div role="list" class="product-slider_list w-dyn-items">
          {%- for fill in (1..repeat) -%}{{ cards_html }}{%- endfor -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
{%- else -%}
  {%- comment -%}
    No [product-slider] attribute here, so the marquee script skips this
    section entirely and nothing scrolls or duplicates.
  {%- endcomment -%}
  <div class="product-draggable_el is-static">
    <div class="product-slider w-dyn-list" udy-collection="product">
      <div role="list" class="product-slider_list w-dyn-items">{{ cards_html }}</div>
    </div>
  </div>
{%- endif -%}

<div class="products-all_wrap">
  {% render 'orgc-detail', url: section.settings.link_url, label: section.settings.link_label, text_class: 'body-upper' %}
</div>
</div>

{% schema %}
{
  "name": "Featured products",
  "tag": "div",
  "class": "page-contain u-container is-section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave empty to show every product in the store. Products must be published to the Online Store sales channel to appear."
    },
    {
      "type": "text",
      "id": "vendor",
      "label": "Only this vendor",
      "info": "Optional. Shows only products whose Vendor matches, so a print-on-demand app's products can be shown on their own. Leave empty for every product."
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Products shown",
      "min": 4,
      "max": 50,
      "step": 1,
      "default": 38
    },
    {
      "type": "richtext",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "<p>( Featured Products )</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "View all products"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 320,
      "step": 4,
      "default": 0,
      "unit": "px",
      "info": "0 keeps the design default."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 320,
      "step": 4,
      "default": 0,
      "unit": "px",
      "info": "0 keeps the design default."
    }
  ],
  "presets": [
    {
      "name": "Featured products",
      "category": "Products",
      "settings": {
        "link_url": "/collections"
      }
    }
  ]
}
{% endschema %}
