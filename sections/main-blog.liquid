{% render 'section-class', classes: 'page-collection u-container', attrs: 'count-items', pt: section.settings.padding_top, pb: section.settings.padding_bottom %}

{%- paginate blog.articles by 24 -%}
<div class="page-inner">
  <div nav-dark="" class="dark-section_wrap">
    <div class="page-intro">
      <div class="shop-contain u-container">
        <div class="shop-intro_wrap">
          <div class="split-grid u-grid-desktop m-flex m-gap_0">
            <div class="split-col u-column-6 m-width_6">
              <div class="body-upper"><p>{{ blog.title }}</p></div>
            </div>
            <div class="split-col u-column-6 u-text-align-right m-push_right m-col_6">
              <p class="body-upper">(&nbsp;<span count-items="total">{{ blog.articles_count }}</span>&nbsp;)</p>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="product-col_wrap w-dyn-list">
      <div role="list" class="product-col_list u-grid-desktop w-dyn-items">
        {%- for article in blog.articles -%}
          <div role="listitem" class="product-col_item u-column-4 w-dyn-item">
            <a count-items="item" overlay="trigger" href="{{ article.url }}" class="cta-block w-inline-block">
              {%- if article.image -%}
                <div cta-cursor_wrap="" class="product-img_wrap">
                  <img src="{{ article.image | image_url: width: 1200 }}" alt="{{ article.title | escape }}" class="product-img" width="{{ article.image.width }}" height="{{ article.image.height }}">
                  <div overlay="el" class="product-overlay"></div>
                </div>
              {%- endif -%}
              <div class="product-block_info is-alt">
                <div class="product-info"><div class="body-upper">{{ article.title }}</div></div>
                <p class="body-upper">{{ article.published_at | date: format: 'date' }}</p>
              </div>
            </a>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Blog",
  "tag": "div",
  "class": "page-collection u-container",
  "settings": [
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 320,
      "step": 4,
      "default": 0,
      "unit": "px",
      "info": "0 keeps the design default."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 320,
      "step": 4,
      "default": 0,
      "unit": "px",
      "info": "0 keeps the design default."
    }
  ]
}
{% endschema %}
