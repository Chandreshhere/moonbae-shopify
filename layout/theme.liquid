<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}"{% if settings.lock_browser_bars %} class="lock-browser-bars"{% endif %} data-money-format="{{ shop.money_format | escape }}" data-money-currency-format="{{ shop.money_with_currency_format | escape }}"{% if settings.tab_away_text != blank %} data-tab-away-text="{{ settings.tab_away_text | escape }}"{% endif %}>
  <head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1" name="viewport">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- assign site_name = settings.brand_name | default: shop.name -%}
    <title>
      {%- if request.page_type == 'index' -%}
        {{ site_name }} &ndash; {{ settings.seo_tagline | default: 'streetwear, made to order in India' }}
      {%- else -%}
        {{ page_title }}
        {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
        {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
        {%- unless page_title contains site_name %} &ndash; {{ site_name }}{% endunless -%}
      {%- endif -%}
    </title>

    {%- comment -%}
      Without a fallback, every page the merchant has not written a description
      for ships with none at all, and the search result gets whatever Google
      scrapes off the page.
    {%- endcomment -%}
    {%- capture meta_description -%}
      {%- if page_description != blank -%}{{ page_description }}
      {%- elsif template.name == 'product' -%}{{ product.description | strip_html | truncatewords: 30 }}
      {%- elsif template.name == 'collection' and collection.description != blank -%}{{ collection.description | strip_html | truncatewords: 30 }}
      {%- elsif shop.description != blank -%}{{ shop.description }}
      {%- else -%}{{ settings.brand_name | default: shop.name }} — clothing made in small runs in India.
      {%- endif -%}
    {%- endcapture -%}
    <meta name="description" content="{{ meta_description | strip | truncate: 300 | escape }}">

    {%- comment -%}
      The design's serif is served by Shopify through font_face below, so the
      Google WebFont loader that used to sit here fetched it a second time and
      blocked rendering while it did. Preconnect to where assets really come from.
    {%- endcomment -%}
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    <script type="text/javascript">!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);</script>

    {%- comment -%}
      Falls back to the bundled monogram on a white ground, so the tab is never
      blank before a merchant uploads their own favicon.
    {%- endcomment -%}
    {% if settings.favicon != blank %}
      <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 32, height: 32 }}" type="image/png">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {% else %}
      <link rel="shortcut icon" href="{{ 'favicon-moonbae.png' | asset_img_url: '32x32' }}" type="image/png">
      <link rel="apple-touch-icon" href="{{ 'favicon-moonbae.png' | asset_img_url: '180x180' }}">
    {% endif %}

    <link rel="stylesheet" href="{{ 'styles.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'styles-2026.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
    <noscript><style>.show-preloader .preloader_wrap{display:none !important}</style></noscript>

    {%- comment -%}
      Theme settings override the design tokens the stylesheets are built on, so
      colour, type and grid are editable without touching CSS. Emitted after the
      stylesheets so :root here wins.
    {%- endcomment -%}
    <style>
      {%- comment -%}
        font_face emits raw @font-face CSS, so it has to live inside this tag.
        Outside it the parser cannot keep the text in <head> and relocates it
        into <body>, where it renders as visible text across the top of every
        page. System fonts emit nothing, which is why that stayed hidden until
        a Shopify-hosted font was selected.
      {%- endcomment -%}
      {%- if settings.font_primary != blank -%}
        {{ settings.font_primary | font_face: font_display: 'swap' }}
        {{ settings.font_primary | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
      {%- endif -%}
      {%- if settings.font_secondary != blank -%}
        {{ settings.font_secondary | font_face: font_display: 'swap' }}
        {{ settings.font_secondary | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
      {%- endif -%}

      :root {
        --swatch--dark: {{ settings.color_dark }};
        --swatch--light: {{ settings.color_light }};
        --swatch--brand: {{ settings.color_brand }};
        --swatch--light-grey: {{ settings.color_light_grey }};
        --swatch--light-faded: {{ settings.color_light_faded }};
        --swatch--faded-text: {{ settings.color_faded_text }};
        --swatch--dark-faded: {{ settings.color_dark }};
        --swatch--dark-faded-1: {{ settings.color_dark | color_modify: 'alpha', 0.1 }};
        --swatch--dark-faded-2: {{ settings.color_dark | color_modify: 'alpha', 0.2 }};
        --swatch--dark-faded-3: {{ settings.color_dark | color_modify: 'alpha', 0.3 }};
        --swatch--dark-faded-4: {{ settings.color_dark | color_modify: 'alpha', 0.4 }};
        --swatch--dark-faded-8: {{ settings.color_dark | color_modify: 'alpha', 0.8 }};

        {%- if settings.font_primary != blank %}
        --_typography---font--primary-family: {{ settings.font_primary.family }}, {{ settings.font_primary.fallback_families }};
        --_typography---font--primary-regular: {{ settings.font_primary.weight }};
        {%- endif %}
        {%- if settings.font_secondary != blank %}
        --_typography---font--secondary-family: {{ settings.font_secondary.family }}, {{ settings.font_secondary.fallback_families }};
        {%- endif %}

        {%- comment -%}
          The design sizes headings on a rem scale that steps down at each
          breakpoint. Writing the merchant's setting out as a flat px value threw
          that away, so a 42px heading stayed 42px on a 390px phone. clamp keeps
          the setting as the desktop ceiling and scales down with the viewport,
          never below a legible floor.
        {%- endcomment -%}
        {%- assign h1 = settings.size_h1 | default: 42 -%}
        {%- assign h3 = settings.size_h3 | default: 42 -%}
        {%- assign h4 = settings.size_h4 | default: 22 -%}
        --_typography---font-size--text-main: {{ settings.size_body | default: 16 }}px;
        --_typography---font-size--h1: clamp({{ h1 | times: 62 | divided_by: 100 }}px, 5.2vw, {{ h1 }}px);
        --_typography---font-size--h2: clamp({{ h1 | times: 62 | divided_by: 100 }}px, 5.2vw, {{ h1 }}px);
        --_typography---font-size--h3: clamp({{ h3 | times: 62 | divided_by: 100 }}px, 5.2vw, {{ h3 }}px);
        --_typography---font-size--h4: clamp({{ h4 | times: 80 | divided_by: 100 }}px, 2.4vw, {{ h4 }}px);

        --brand--logo-preloader: {{ settings.logo_preloader_size | default: 48 }}px;
        --brand--mono-icon: {{ settings.mono_icon_size | default: 64 }}px;

        --site--width: {{ settings.site_width | default: 1920 }}px;
        --site--margin: {{ settings.site_margin | default: 20 }}px;
        --site--gutter: {{ settings.site_gutter | default: 10 }}px;
        --site--column-count: {{ settings.site_columns | default: 12 }};
      }
    </style>

    {{ content_for_header }}

    {%- comment -%} Social link previews and structured data, after content_for_header so they win. {%- endcomment -%}
    {% render 'meta-tags' %}
  </head>

  {%- comment -%}
    Body and nav classes follow the reference site page for page: the product page
    carries u-theme-light, product and collection get the dark nav, and
    show-preloader is present on load (scripts-2026.js strips it for repeat visits
    in the same session — see checkPreloader).
  {%- endcomment -%}
  {%- assign body_theme = '' -%}
  {%- if template.name == 'product' -%}{%- assign body_theme = 'u-theme-light ' -%}{%- endif -%}
  <body data-barba="wrapper" class="{{ body_theme }}{% if settings.show_preloader %}show-preloader {% endif %}template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix }}{% endif %}">
    <div class="page_wrap">
      <div class="page_code_wrap">
        <div class="page_code_base w-embed"></div>
        <div class="page_code_custom w-embed"></div>
      </div>

      {%- comment -%}
        Barba swaps this container but never touches <body>, so the template
        classes the CSS keys off would go stale on every transition. The
        container carries its own copy and scripts-2026.js copies it across.
      {%- endcomment -%}
      <div data-barba="container" class="page-main" data-template-classes="{{ body_theme | strip }} template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix }}{% endif %}">
        {%- comment -%}
          Inside the Barba container, and first in it. It used to sit outside on
          the grounds that it had nothing page-specific in it — but it does now
          that it can be limited to the home page, and anything outside the
          container is never swapped, so a bar rendered once would have followed
          the visitor onto every page it was supposed to be absent from.

          In here it arrives and leaves as part of the page, which also means
          nothing above the container changes height mid-transition: the
          container always lands at the top of the page whether or not the page
          it is carrying has a bar.
        {%- endcomment -%}
        {% section 'announcement-bar' %}
        {% render 'preloader' %}
        {% section 'header' %}

        {%- comment -%}
          Each template renders its own footer, because the reference uses the light
          footer on home and cart, the dark one on product / collection / policy
          pages, a bespoke one on About, and none at all on Contact.
        {%- endcomment -%}
        {{ content_for_layout }}

        {% section 'easter' %}

        <div class="cursor">
          <div class="orgc-detail">
            {% render 'icon-bracket-left' %}
            <p class="cursor-text"></p>
            {% render 'icon-bracket-right' %}
          </div>
        </div>
      </div>
    </div>


    {%- comment -%}
      Loaded in exactly the order the reference build used. Every library is
      vendored into assets/ so the theme has no third-party runtime dependency.
    {%- endcomment -%}
    <script src="{{ 'vendor-jquery.js' | asset_url }}" defer></script>
    <script src="{{ 'vendor-webflow.js' | asset_url }}" defer></script>
    <script src="{{ 'vendor-barba.js' | asset_url }}" defer></script>
    <script src="{{ 'vendor-gsap.js' | asset_url }}" defer></script>
    <script src="{{ 'vendor-gsap-observer.js' | asset_url }}" defer></script>
    <script src="{{ 'vendor-gsap-scrolltrigger.js' | asset_url }}" defer></script>
    <script src="{{ 'vendor-gsap-customease.js' | asset_url }}" defer></script>
    <script src="{{ 'vendor-hammer.js' | asset_url }}" defer></script>
    <script src="{{ 'vendor-split-type.js' | asset_url }}" defer></script>
    <script src="{{ 'vendor-lenis.js' | asset_url }}" defer></script>
    <script>window.UdeslyCartScript = {{ 'vendor-udesly-shopify.js' | asset_url | json }};</script>
    <script src="{{ 'scripts-2026.js' | asset_url }}" defer></script>
    <script>
      // Fail-safe. The preloader overlay is display:flex while <body> carries
      // show-preloader, and scripts-2026.js only drops that class when its GSAP
      // timeline completes. If any vendor script fails to load or throws, the
      // overlay would otherwise cover the storefront permanently. Nothing here
      // runs when the normal path works, because the class is already gone.
      (function () {
        var lift = function () { document.body.classList.remove('show-preloader'); };
        window.addEventListener('load', function () { setTimeout(lift, 4000); });
        setTimeout(lift, 10000);
      })();
    </script>
    <script src="https://cdn.shopify.com/storefront/standard-actions.js" defer></script>
    <script>
      window.Theme = {
        moneyFormat: {{ shop.money_format | json }},
        strings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }}
        }
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
