<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}" data-money-format="{{ shop.money_format | escape }}">
  <head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1" name="viewport">
    <link rel="canonical" href="{{ canonical_url }}">

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin="anonymous">
    <script src="https://ajax.googleapis.com/ajax/libs/webfont/1.6.26/webfont.js" type="text/javascript"></script>
    <script type="text/javascript">WebFont.load({
google: {
families: ["Instrument Serif:regular,italic"]
}});</script>
    <script type="text/javascript">!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);</script>

    {% if settings.favicon != blank %}
      <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 32, height: 32 }}" type="image/png">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {% endif %}

    <link rel="stylesheet" href="{{ 'styles.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'styles-2026.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
    <noscript><style>.show-preloader .preloader_wrap{display:none !important}</style></noscript>

    {%- comment -%}
      Theme settings override the design tokens the stylesheets are built on, so
      colour, type and grid are editable without touching CSS. Emitted after the
      stylesheets so :root here wins.
    {%- endcomment -%}
    {%- if settings.font_primary != blank -%}
      {{ settings.font_primary | font_face: font_display: 'swap' }}
      {{ settings.font_primary | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
    {%- endif -%}
    {%- if settings.font_secondary != blank -%}
      {{ settings.font_secondary | font_face: font_display: 'swap' }}
      {{ settings.font_secondary | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
    {%- endif -%}
    <style>
      :root {
        --swatch--dark: {{ settings.color_dark }};
        --swatch--light: {{ settings.color_light }};
        --swatch--brand: {{ settings.color_brand }};
        --swatch--light-grey: {{ settings.color_light_grey }};
        --swatch--light-faded: {{ settings.color_light_faded }};
        --swatch--faded-text: {{ settings.color_faded_text }};
        --swatch--dark-faded: {{ settings.color_dark }};
        --swatch--dark-faded-1: {{ settings.color_dark | color_modify: 'alpha', 0.1 }};
        --swatch--dark-faded-2: {{ settings.color_dark | color_modify: 'alpha', 0.2 }};
        --swatch--dark-faded-3: {{ settings.color_dark | color_modify: 'alpha', 0.3 }};
        --swatch--dark-faded-4: {{ settings.color_dark | color_modify: 'alpha', 0.4 }};
        --swatch--dark-faded-8: {{ settings.color_dark | color_modify: 'alpha', 0.8 }};

        {%- if settings.font_primary != blank %}
        --_typography---font--primary-family: {{ settings.font_primary.family }}, {{ settings.font_primary.fallback_families }};
        --_typography---font--primary-regular: {{ settings.font_primary.weight }};
        {%- endif %}
        {%- if settings.font_secondary != blank %}
        --_typography---font--secondary-family: {{ settings.font_secondary.family }}, {{ settings.font_secondary.fallback_families }};
        {%- endif %}

        --_typography---font-size--text-main: {{ settings.size_body | default: 16 }}px;
        --_typography---font-size--h1: {{ settings.size_h1 | default: 42 }}px;
        --_typography---font-size--h2: {{ settings.size_h1 | default: 42 }}px;
        --_typography---font-size--h3: {{ settings.size_h3 | default: 42 }}px;
        --_typography---font-size--h4: {{ settings.size_h4 | default: 22 }}px;

        --site--width: {{ settings.site_width | default: 1920 }}px;
        --site--margin: {{ settings.site_margin | default: 20 }}px;
        --site--gutter: {{ settings.site_gutter | default: 10 }}px;
        --site--column-count: {{ settings.site_columns | default: 12 }};
      }
    </style>

    {{ content_for_header }}
  </head>

  {%- comment -%}
    Body and nav classes follow the reference site page for page: the product page
    carries u-theme-light, product and collection get the dark nav, and
    show-preloader is present on load (scripts-2026.js strips it for repeat visits
    in the same session — see checkPreloader).
  {%- endcomment -%}
  {%- assign body_theme = '' -%}
  {%- if template.name == 'product' -%}{%- assign body_theme = 'u-theme-light ' -%}{%- endif -%}
  <body data-barba="wrapper" class="{{ body_theme }}{% if settings.show_preloader %}show-preloader {% endif %}template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix }}{% endif %}">
    <div class="page_wrap">
      <div class="page_code_wrap">
        <div class="page_code_base w-embed"></div>
        <div class="page_code_custom w-embed"></div>
      </div>

      <div data-barba="container" class="page-main">
        {% render 'preloader' %}
        {% section 'header' %}

        {%- comment -%}
          Each template renders its own footer, because the reference uses the light
          footer on home and cart, the dark one on product / collection / policy
          pages, a bespoke one on About, and none at all on Contact.
        {%- endcomment -%}
        {{ content_for_layout }}

        {% section 'easter' %}

        <div class="cursor">
          <div class="orgc-detail">
            {% render 'icon-bracket-left' %}
            <p class="cursor-text"></p>
            {% render 'icon-bracket-right' %}
          </div>
        </div>
      </div>
    </div>

    {% section 'signup-popup' %}

    {%- comment -%}
      Loaded in exactly the order the reference build used. Every library is
      vendored into assets/ so the theme has no third-party runtime dependency.
    {%- endcomment -%}
    <script src="{{ 'vendor-jquery.js' | asset_url }}" type="text/javascript"></script>
    <script src="{{ 'vendor-webflow.js' | asset_url }}" type="text/javascript"></script>
    <script src="{{ 'vendor-barba.js' | asset_url }}"></script>
    <script src="{{ 'vendor-gsap.js' | asset_url }}"></script>
    <script src="{{ 'vendor-gsap-flip.js' | asset_url }}"></script>
    <script src="{{ 'vendor-gsap-observer.js' | asset_url }}"></script>
    <script src="{{ 'vendor-gsap-scrolltrigger.js' | asset_url }}"></script>
    <script src="{{ 'vendor-gsap-customease.js' | asset_url }}"></script>
    <script src="{{ 'vendor-hammer.js' | asset_url }}"></script>
    <script src="{{ 'vendor-lottie.js' | asset_url }}"></script>
    <script src="{{ 'vendor-split-type.js' | asset_url }}"></script>
    <script src="{{ 'vendor-lenis.js' | asset_url }}"></script>
    <script>window.UdeslyCartScript = {{ 'vendor-udesly-shopify.js' | asset_url | json }};</script>
    <script src="{{ 'scripts-2026.js' | asset_url }}"></script>
    <script>
      // Fail-safe. The preloader overlay is display:flex while <body> carries
      // show-preloader, and scripts-2026.js only drops that class when its GSAP
      // timeline completes. If any vendor script fails to load or throws, the
      // overlay would otherwise cover the storefront permanently. Nothing here
      // runs when the normal path works, because the class is already gone.
      (function () {
        var lift = function () { document.body.classList.remove('show-preloader'); };
        window.addEventListener('load', function () { setTimeout(lift, 4000); });
        setTimeout(lift, 10000);
      })();
    </script>
    <script src="https://cdn.shopify.com/storefront/standard-actions.js" defer></script>
    <script>
      window.Theme = {
        moneyFormat: {{ shop.money_format | json }},
        strings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }}
        }
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
