{%- liquid
  comment
    Ads load on the home page, the About page and the blog only. Keep in step
    with adsZone() in scripts-2026.js, which decides page changes by path.
  endcomment
  assign ads_here = false
  if template.name == 'index' or template.name == 'blog' or template.name == 'article'
    assign ads_here = true
  elsif template.name == 'page' and template.suffix == 'about'
    assign ads_here = true
  endif
  if settings.adsense_client == blank or request.design_mode
    assign ads_here = false
  endif
-%}
<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}"{% if ads_here %} data-ads{% endif %}{% if settings.show_discount == false %} data-no-discount{% endif %}{% if settings.lock_browser_bars %} class="lock-browser-bars"{% endif %} data-money-format="{{ shop.money_format | escape }}" data-money-currency-format="{{ shop.money_with_currency_format | escape }}"{% if settings.tab_away_text != blank %} data-tab-away-text="{{ settings.tab_away_text | escape }}"{% endif %}>
  <head>
    <meta charset="utf-8">
    {%- comment -%}
      Which commit of main this theme was built from. The sync workflow writes
      the short SHA into snippets/theme-build.liquid on the shopify branch; in
      the repository itself it reads "dev".
    {%- endcomment -%}
    {%- capture theme_build -%}{% render 'theme-build' %}{%- endcapture %}
    <meta name="theme-build" content="{{ theme_build | strip | escape }}">
    <meta content="width=device-width, initial-scale=1" name="viewport">
    {%- assign site_name = settings.brand_name | default: shop.name -%}
    {%- liquid
      comment
        Category views share /collections/all, whose own title is "Products".
        Each gets its own title, description and canonical so it can rank as
        a page of its own; when a real collection exists for the category
        (handle hoodies, t-shirts or baby-tees, with products) the view points
        its canonical there instead.
      endcomment
      assign view_title = ''
      assign view_tag = ''
      assign view_desc = ''
      assign view_handles = ''
      if template.name == 'collection'
        case template.suffix
          when 'hoodies'
            assign view_title = 'Hoodies'
            assign view_tag = 'Boxy Graphic Hoodies, 360 GSM'
            assign view_desc = 'Boxy graphic hoodies in 360 GSM cotton fleece. Every design is picked and reworked by Moon, then printed in India after you order. Sizes S to XL.'
            assign view_handles = 'hoodies,hoodie'
          when 'tshirts'
            assign view_title = 'T-shirts'
            assign view_tag = 'Boxy and Oversized Graphic Tees'
            assign view_desc = 'Boxy fit and oversized graphic tees in 240 GSM cotton, plus waffle knit full sleeves. Each design is curated by Moon and printed to order in India.'
            assign view_handles = 't-shirts,tshirts,t-shirt'
          when 'babytees'
            assign view_title = 'Baby tees'
            assign view_tag = "Women's Y2K Baby Tees"
            assign view_desc = "Fitted Y2K baby tees for women in 220 GSM cotton with a little stretch (95% cotton, 5% lycra). Sizes XS to XXL, printed to order in India."
            assign view_handles = 'baby-tees,babytees,baby-tee'
          when 'men'
            assign view_title = 'Men'
            assign view_tag = 'Graphic Hoodies and Tees for Men'
            assign view_desc = 'Graphic hoodies, boxy and oversized tees and waffle knits from Moonbae: wearable art curated by Moon, printed to order in India.'
          when 'women'
            assign view_title = 'Women'
            assign view_tag = 'Baby Tees, Graphic Tees and Hoodies for Women'
            assign view_desc = 'Fitted Y2K baby tees plus unisex graphic hoodies and tees from Moonbae: wearable art curated by Moon, printed to order in India.'
        endcase
      endif

      assign seo_canonical = canonical_url
      if view_title != blank and collection.handle == 'all'
        assign seo_canonical = canonical_url | split: '?' | first | append: '?view=' | append: template.suffix
        assign vh = view_handles | split: ','
        for h in vh
          assign found = collections[h].products_count | plus: 0
          if found > 0
            assign seo_canonical = request.origin | append: collections[h].url
            break
          endif
        endfor
      endif

      comment
        Search results are thin and endless, so they stay out of the index;
        links on them are still followed.
      endcomment
      assign seo_robots = ''
      if template.name == 'search'
        assign seo_robots = 'noindex, follow'
      endif

      comment
        Products: most descriptions are only the product name (Unitee fills
        them in that way), which gives search engines nothing to read. When
        the description adds fewer than 40 characters to the title, the title
        and description below are built from the garment's facts instead
        (snippets/garment-facts). A real description or an SEO title set in
        Shopify admin always wins.
      endcomment
      assign desc_thin = false
      if template.name == 'product'
        capture gf
          render 'garment-facts', product: product
        endcapture
        assign gf = gf | split: '|'
        assign desc_text = product.description | strip_html | strip_newlines | strip
        assign desc_extra = desc_text | remove: product.title | strip
        if desc_extra.size < 40
          assign desc_thin = true
        endif
        assign pd = page_description | strip_html | strip_newlines | strip
        assign pd_extra = pd | remove: product.title | strip
        assign use_generated_desc = false
        if desc_thin and pd_extra.size < 40
          assign use_generated_desc = true
        endif
      endif
    -%}
    <link rel="canonical" href="{{ seo_canonical }}">
    {%- if seo_robots != blank %}
    <meta name="robots" content="{{ seo_robots }}">
    {%- endif %}
    {%- capture seo_title -%}
      {%- if request.page_type == 'index' -%}
        {{ site_name }} &ndash; {{ settings.seo_tagline | default: 'wearable art, curated by Moon' }}
      {%- elsif view_title != blank -%}
        {{ view_title }} | {{ view_tag }} &ndash; {{ site_name }}
      {%- elsif template.name == 'product' and page_title == product.title and gf[2] != blank -%}
        {{ product.title }} | {{ gf[2] }} &ndash; {{ site_name }}
      {%- else -%}
        {{ page_title }}
        {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
        {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
        {%- unless page_title contains site_name %} &ndash; {{ site_name }}{% endunless -%}
      {%- endif -%}
    {%- endcapture -%}
    {%- comment -%}
      The capture keeps stray line breaks out of the title ("About↵ – Moonbae").
    {%- endcomment -%}
    {%- assign seo_title = seo_title | strip_newlines | strip -%}
    <title>{{ seo_title }}</title>

    {%- comment -%}
      Without a fallback, every page the merchant has not written a description
      for ships with none at all, and the search result gets whatever Google
      scrapes off the page. Each kind of page gets its own fallback rather
      than all sharing the site description.
    {%- endcomment -%}
    {%- capture meta_description -%}
      {%- if template.name == 'product' and use_generated_desc -%}
        {%- if gf[0] != blank -%}
          {{ product.title }}: a {% if gf[6] != blank %}{{ gf[6] | downcase }} {% endif %}{% if gf[3] != blank %}{{ gf[3] }} GSM {% endif %}{{ gf[1] }} in {{ gf[4] | downcase }}, with a design curated by Moon. Printed to order in India and dispatched in 2–4 business days.
        {%- else -%}
          {{ product.title }} by {{ site_name }}: wearable art curated by Moon, printed to order in India and dispatched in 2–4 business days.
        {%- endif -%}
        {%- unless product.has_only_default_variant %} Sizes {{ product.options_with_values.first.values.first }}–{{ product.options_with_values.first.values.last }},{% endunless %} {{ product.price | money_without_trailing_zeros | strip_html }}.
      {%- elsif page_description != blank -%}{{ page_description }}
      {%- elsif template.name == 'product' -%}{{ product.description | strip_html | truncatewords: 30 }}
      {%- elsif template.name == 'collection' and collection.description != blank -%}{{ collection.description | strip_html | truncatewords: 30 }}
      {%- elsif view_desc != blank -%}{{ view_desc }}
      {%- elsif template.name == 'collection' -%}{{ collection.title }} at {{ site_name }}: wearable art curated by Moon, printed to order in India and dispatched in 2–4 business days.
      {%- elsif template.name == 'page' and page.handle == 'about' -%}About {{ site_name }}: a small Indian label where Moon picks every design, reworks it for the garment and prints it to order on hoodies, tees and baby tees for artists and creative people.
      {%- elsif template.name == 'page' and page.handle == 'contact' -%}Contact {{ site_name }} about sizes, orders and delivery. Every hoodie, tee and baby tee is printed to order in India after you buy it.
      {%- elsif template.name == 'page' and page.content != blank -%}{{ page.content | strip_html | truncatewords: 30 }}
      {%- elsif request.page_type == 'policy' -%}{{ site_name }} {{ page_title | downcase }}: how ordering, printing, delivery and replacements work for our made-to-order hoodies and tees in India.
      {%- elsif template.name == 'blog' -%}News from {{ site_name }}: new drops, the designs behind them and how each piece is printed to order in India.
      {%- elsif shop.description != blank -%}{{ shop.description }}
      {%- else -%}{{ site_name }} makes wearable art curated by Moon: hoodies, tees and baby tees, printed to order in India for artists and creative people.
      {%- endif -%}
    {%- endcapture -%}
    {%- assign meta_description = meta_description | strip_html | strip_newlines | strip | truncate: 300 -%}
    <meta name="description" content="{{ meta_description | escape }}">

    {%- comment -%}
      The design's serif is served by Shopify through font_face below, so the
      Google WebFont loader that used to sit here fetched it a second time and
      blocked rendering while it did. Preconnect to where assets really come from.
    {%- endcomment -%}
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    <script type="text/javascript">!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);</script>

    {%- comment -%}
      Falls back to the bundled monogram on a white ground, so the tab is never
      blank before a merchant uploads their own favicon.
    {%- endcomment -%}
    {% if settings.favicon != blank %}
      <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 32, height: 32 }}" type="image/png">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {% else %}
      <link rel="shortcut icon" href="{{ 'favicon-moonbae.png' | asset_img_url: '32x32' }}" type="image/png">
      <link rel="apple-touch-icon" href="{{ 'favicon-moonbae.png' | asset_img_url: '180x180' }}">
    {% endif %}

    <link rel="stylesheet" href="{{ 'styles.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'styles-2026.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
    <noscript><style>.show-preloader .preloader_wrap{display:none !important}</style></noscript>

    {%- comment -%}
      Theme settings override the design tokens the stylesheets are built on, so
      colour, type and grid are editable without touching CSS. Emitted after the
      stylesheets so :root here wins.
    {%- endcomment -%}
    <style>
      {%- comment -%}
        font_face emits raw @font-face CSS, so it has to live inside this tag.
        Outside it the parser cannot keep the text in <head> and relocates it
        into <body>, where it renders as visible text across the top of every
        page. System fonts emit nothing, which is why that stayed hidden until
        a Shopify-hosted font was selected.
      {%- endcomment -%}
      {%- if settings.font_primary != blank -%}
        {{ settings.font_primary | font_face: font_display: 'swap' }}
        {{ settings.font_primary | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
      {%- endif -%}
      {%- if settings.font_secondary != blank -%}
        {{ settings.font_secondary | font_face: font_display: 'swap' }}
        {{ settings.font_secondary | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
      {%- endif -%}

      :root {
        --swatch--dark: {{ settings.color_dark }};
        --swatch--light: {{ settings.color_light }};
        --swatch--brand: {{ settings.color_brand }};
        --swatch--light-grey: {{ settings.color_light_grey }};
        --swatch--light-faded: {{ settings.color_light_faded }};
        --swatch--sale: {{ settings.color_sale | default: '#d62d20' }};
        --swatch--sale-badge: {{ settings.color_sale_badge | default: '#050fff' }};
        --swatch--faded-text: {{ settings.color_faded_text }};
        --swatch--dark-faded: {{ settings.color_dark }};
        --swatch--dark-faded-1: {{ settings.color_dark | color_modify: 'alpha', 0.1 }};
        --swatch--dark-faded-2: {{ settings.color_dark | color_modify: 'alpha', 0.2 }};
        --swatch--dark-faded-3: {{ settings.color_dark | color_modify: 'alpha', 0.3 }};
        --swatch--dark-faded-4: {{ settings.color_dark | color_modify: 'alpha', 0.4 }};
        --swatch--dark-faded-8: {{ settings.color_dark | color_modify: 'alpha', 0.8 }};

        {%- if settings.font_primary != blank %}
        --_typography---font--primary-family: {{ settings.font_primary.family }}, {{ settings.font_primary.fallback_families }};
        --_typography---font--primary-regular: {{ settings.font_primary.weight }};
        {%- endif %}
        {%- if settings.font_secondary != blank %}
        --_typography---font--secondary-family: {{ settings.font_secondary.family }}, {{ settings.font_secondary.fallback_families }};
        {%- endif %}

        {%- comment -%}
          The design sizes headings on a rem scale that steps down at each
          breakpoint. Writing the merchant's setting out as a flat px value threw
          that away, so a 42px heading stayed 42px on a 390px phone. clamp keeps
          the setting as the desktop ceiling and scales down with the viewport,
          never below a legible floor.
        {%- endcomment -%}
        {%- assign h1 = settings.size_h1 | default: 42 -%}
        {%- assign h3 = settings.size_h3 | default: 42 -%}
        {%- assign h4 = settings.size_h4 | default: 22 -%}
        --_typography---font-size--text-main: {{ settings.size_body | default: 16 }}px;
        --_typography---font-size--h1: clamp({{ h1 | times: 62 | divided_by: 100 }}px, 5.2vw, {{ h1 }}px);
        --_typography---font-size--h2: clamp({{ h1 | times: 62 | divided_by: 100 }}px, 5.2vw, {{ h1 }}px);
        --_typography---font-size--h3: clamp({{ h3 | times: 62 | divided_by: 100 }}px, 5.2vw, {{ h3 }}px);
        --_typography---font-size--h4: clamp({{ h4 | times: 80 | divided_by: 100 }}px, 2.4vw, {{ h4 }}px);

        --brand--logo-preloader: {{ settings.logo_preloader_size | default: 48 }}px;
        --brand--mono-icon: {{ settings.mono_icon_size | default: 64 }}px;

        --site--width: {{ settings.site_width | default: 1920 }}px;
        --site--margin: {{ settings.site_margin | default: 20 }}px;
        --site--gutter: {{ settings.site_gutter | default: 10 }}px;
        --site--column-count: {{ settings.site_columns | default: 12 }};
      }
    </style>

    {%- comment -%}
      Google AdSense. Publisher ID from Theme settings → Google AdSense; clear
      it to remove the script. Loaded only where ads_here (top of this file)
      allows: home, About and the blog. Not loaded inside the theme editor.
    {%- endcomment -%}
    {%- if settings.adsense_client != blank -%}
      <meta name="google-adsense-account" content="{{ settings.adsense_client | strip | escape }}">
    {%- endif -%}
    {%- if ads_here -%}
      <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client={{ settings.adsense_client | strip | url_encode }}" crossorigin="anonymous"></script>
    {%- endif -%}

    {{ content_for_header }}

    {%- comment -%} Social link previews and structured data, after content_for_header so they win. {%- endcomment -%}
    {% render 'meta-tags', view_title: view_title, seo_title: seo_title, seo_description: meta_description, seo_canonical: seo_canonical %}
  </head>

  {%- comment -%}
    Body and nav classes follow the reference site page for page: the product page
    carries u-theme-light, product and collection get the dark nav, and
    show-preloader is present on load (scripts-2026.js strips it for repeat visits
    in the same session — see checkPreloader).
  {%- endcomment -%}
  {%- assign body_theme = '' -%}
  {%- if template.name == 'product' -%}{%- assign body_theme = 'u-theme-light ' -%}{%- endif -%}
  <body data-barba="wrapper" class="{{ body_theme }}{% if settings.show_preloader %}show-preloader {% endif %}template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix }}{% endif %}">
    <div class="page_wrap">
      <div class="page_code_wrap">
        <div class="page_code_base w-embed"></div>
        <div class="page_code_custom w-embed"></div>
      </div>

      {%- comment -%}
        Barba swaps this container but never touches <body>, so the template
        classes the CSS keys off would go stale on every transition. The
        container carries its own copy and scripts-2026.js copies it across.
      {%- endcomment -%}
      <div data-barba="container" class="page-main" data-template-classes="{{ body_theme | strip }} template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix }}{% endif %}">
        {%- comment -%}
          Inside the Barba container, and first in it. It used to sit outside on
          the grounds that it had nothing page-specific in it — but it does now
          that it can be limited to the home page, and anything outside the
          container is never swapped, so a bar rendered once would have followed
          the visitor onto every page it was supposed to be absent from.

          In here it arrives and leaves as part of the page, which also means
          nothing above the container changes height mid-transition: the
          container always lands at the top of the page whether or not the page
          it is carrying has a bar.
        {%- endcomment -%}
        {% section 'announcement-bar' %}
        {% render 'preloader' %}
        {% section 'header' %}

        {%- comment -%}
          Each template renders its own footer, because the reference uses the light
          footer on home and cart, the dark one on product / collection / policy
          pages, a bespoke one on About, and none at all on Contact.
        {%- endcomment -%}
        {{ content_for_layout }}

        {% section 'easter' %}

        <div class="cursor">
          <div class="orgc-detail">
            {% render 'icon-bracket-left' %}
            <p class="cursor-text"></p>
            {% render 'icon-bracket-right' %}
          </div>
        </div>
      </div>
    </div>


    {%- comment -%}
      Loaded in exactly the order the reference build used. Every library is
      vendored into assets/ so the theme has no third-party runtime dependency.
    {%- endcomment -%}
    <script src="{{ 'vendor-jquery.js' | asset_url }}" defer></script>
    <script src="{{ 'vendor-webflow.js' | asset_url }}" defer></script>
    <script src="{{ 'vendor-barba.js' | asset_url }}" defer></script>
    <script src="{{ 'vendor-gsap.js' | asset_url }}" defer></script>
    <script src="{{ 'vendor-gsap-observer.js' | asset_url }}" defer></script>
    <script src="{{ 'vendor-gsap-scrolltrigger.js' | asset_url }}" defer></script>
    <script src="{{ 'vendor-gsap-customease.js' | asset_url }}" defer></script>
    <script src="{{ 'vendor-hammer.js' | asset_url }}" defer></script>
    <script src="{{ 'vendor-split-type.js' | asset_url }}" defer></script>
    <script src="{{ 'vendor-lenis.js' | asset_url }}" defer></script>
    <script>window.UdeslyCartScript = {{ 'vendor-udesly-shopify.js' | asset_url | json }};</script>
    <script src="{{ 'scripts-2026.js' | asset_url }}" defer></script>
    <script>
      // Fail-safe. The preloader overlay is display:flex while <body> carries
      // show-preloader, and scripts-2026.js only drops that class when its GSAP
      // timeline completes. If any vendor script fails to load or throws, the
      // overlay would otherwise cover the storefront permanently. Nothing here
      // runs when the normal path works, because the class is already gone.
      (function () {
        var lift = function () { document.body.classList.remove('show-preloader'); };
        window.addEventListener('load', function () { setTimeout(lift, 4000); });
        setTimeout(lift, 10000);
      })();
    </script>
    <script>
      window.Theme = {
        moneyFormat: {{ shop.money_format | json }},
        strings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }}
        }
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
