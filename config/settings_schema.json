[
  {
    "name": "theme_info",
    "theme_name": "moonbae",
    "theme_version": "1.0.0",
    "theme_author": "moonbae",
    "theme_documentation_url": "https://shopify.dev/docs/themes",
    "theme_support_url": "https://shopify.dev/docs/themes"
  },
  {
    "name": "Branding",
    "settings": [
      {
        "type": "text",
        "id": "brand_name",
        "label": "Brand name",
        "default": "moonbae",
        "info": "Used as the alt text on every logo and monogram."
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "image_picker",
        "id": "social_image",
        "label": "Social share image",
        "info": "Shown when a link to the store is shared. 1200x630 works everywhere. Falls back to the dark logo."
      },
      {
        "type": "url",
        "id": "social_instagram",
        "label": "Instagram URL",
        "info": "Used in structured data so search engines can link the brand to its social profile."
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "site_width",
        "label": "Max site width (px)",
        "min": 1200,
        "max": 2400,
        "step": 20,
        "default": 1920,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "site_margin",
        "label": "Page margin (px)",
        "min": 8,
        "max": 80,
        "step": 2,
        "default": 20,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "site_gutter",
        "label": "Grid gutter (px)",
        "min": 4,
        "max": 48,
        "step": 1,
        "default": 10,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "site_columns",
        "label": "Grid columns",
        "min": 6,
        "max": 16,
        "step": 1,
        "default": 12
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_primary",
        "label": "Primary (UI, body, headings)",
        "default": "assistant_n4"
      },
      {
        "type": "font_picker",
        "id": "font_secondary",
        "label": "Secondary (italic display numerals)",
        "default": "instrument_serif_n4"
      },
      {
        "type": "paragraph",
        "content": "Type scale — the design is fluid, so these set the upper end of each clamp."
      },
      {
        "type": "range",
        "id": "size_body",
        "label": "Body size (px)",
        "min": 12,
        "max": 22,
        "step": 1,
        "default": 16,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "size_h1",
        "label": "Display / H1 (px)",
        "min": 32,
        "max": 128,
        "step": 1,
        "default": 42,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "size_h3",
        "label": "H3 (px)",
        "min": 24,
        "max": 96,
        "step": 1,
        "default": 42,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "size_h4",
        "label": "H4 (px)",
        "min": 14,
        "max": 48,
        "step": 1,
        "default": 22,
        "unit": "px"
      }
    ]
  },
  {
    "name": "Colours",
    "settings": [
      {
        "type": "paragraph",
        "content": "These drive the whole design. Every section, the nav, footers and the cart inherit them."
      },
      {
        "type": "color",
        "id": "color_dark",
        "label": "Dark",
        "default": "#000000"
      },
      {
        "type": "color",
        "id": "color_light",
        "label": "Light",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_brand",
        "label": "Brand accent",
        "default": "#050fff"
      },
      {
        "type": "color",
        "id": "color_light_grey",
        "label": "Light grey (image grounds)",
        "default": "#f4f4f4"
      },
      {
        "type": "color",
        "id": "color_light_faded",
        "label": "Muted text on light",
        "default": "#818181"
      },
      {
        "type": "color",
        "id": "color_faded_text",
        "label": "Muted text on dark",
        "default": "#cccccc"
      }
    ]
  },
  {
    "name": "Brand marks",
    "settings": [
      {
        "type": "paragraph",
        "content": "Every slot falls back to the built-in moonbae artwork when left empty. The artwork is fixed-colour, so upload a light version for dark backgrounds and a dark version for light ones. Sizes for the header, menu, footer, intro, about, contact and made-locally marks live in those sections."
      },
      {
        "type": "header",
        "content": "Logo (wordmark)"
      },
      {
        "type": "image_picker",
        "id": "logo_light",
        "label": "Logo — light",
        "info": "White artwork. Used on the header, preloader and dark footer."
      },
      {
        "type": "image_picker",
        "id": "logo_dark",
        "label": "Logo — dark",
        "info": "Black artwork. Used on light-ground pages and the light footer."
      },
      {
        "type": "header",
        "content": "Monogram"
      },
      {
        "type": "image_picker",
        "id": "mono_light",
        "label": "Monogram — light",
        "info": "White linework. Used on the menu panel."
      },
      {
        "type": "image_picker",
        "id": "mono_dark",
        "label": "Monogram — dark",
        "info": "Black linework. Used on the intro, about, contact and made-locally sections and the newsletter success state."
      },
      {
        "type": "header",
        "content": "Sizes (slots without a section)"
      },
      {
        "type": "range",
        "id": "logo_preloader_size",
        "label": "Preloader logo height",
        "min": 24,
        "max": 240,
        "step": 4,
        "unit": "px",
        "default": 48
      },
      {
        "type": "range",
        "id": "mono_icon_size",
        "label": "Small monogram height",
        "min": 24,
        "max": 240,
        "step": 4,
        "unit": "px",
        "default": 64,
        "info": "Newsletter success, gift card and password page."
      },
      {
        "type": "header",
        "content": "Other artwork"
      },
      {
        "type": "image_picker",
        "id": "logo_easter",
        "label": "Easter-egg icon"
      }
    ]
  },
  {
    "name": "Preloader",
    "settings": [
      {
        "type": "paragraph",
        "content": "Eight images cycle behind the wordmark while the page loads. Bundled placeholders are used for any slot left empty."
      },
      {
        "type": "image_picker",
        "id": "preloader_image_1",
        "label": "Image 1"
      },
      {
        "type": "image_picker",
        "id": "preloader_image_2",
        "label": "Image 2"
      },
      {
        "type": "image_picker",
        "id": "preloader_image_3",
        "label": "Image 3"
      },
      {
        "type": "image_picker",
        "id": "preloader_image_4",
        "label": "Image 4"
      },
      {
        "type": "image_picker",
        "id": "preloader_image_5",
        "label": "Image 5"
      },
      {
        "type": "image_picker",
        "id": "preloader_image_6",
        "label": "Image 6"
      },
      {
        "type": "image_picker",
        "id": "preloader_image_7",
        "label": "Image 7"
      },
      {
        "type": "image_picker",
        "id": "preloader_image_8",
        "label": "Image 8"
      }
    ]
  },
  {
    "name": "Behaviour",
    "settings": [
      {
        "type": "checkbox",
        "id": "smooth_scroll",
        "label": "Smooth scrolling",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "custom_cursor",
        "label": "Custom cursor",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_preloader",
        "label": "Show preloader",
        "default": true
      },
      {
        "type": "text",
        "id": "tab_away_text",
        "label": "Tab messages when someone switches away",
        "default": "Come back — your cart is waiting | We miss you already | The moon is still up. So is your cart. | Still here. Still your size. | Psst… you left something behind | Your tee is getting lonely | Don't make us count the stars alone | Free shipping doesn't wait up",
        "info": "Shown in the browser tab while the visitor is on another tab. Separate several with a | and they cycle. Leave empty to turn off."
      }
    ]
  },
