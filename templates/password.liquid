{% layout 'password' %}
<div class="u-container password-page">
  <div class="or-info">
    <div class="u-text-align-center">
      <div class="full-logo_wrap">{% render 'brand-mono', variant: 'dark', class: 'is-intro' %}</div>
      <div class="text-style_alt-large">{{ shop.password_message }}</div>
      {% form 'storefront_password' %}
        {{ form.errors | default_errors }}
        <input type="password" name="password" class="body-upper" placeholder="{{ 'general.password_page.password_placeholder' | t }}">
        <button type="submit" class="checkout-button body-upper">{{ 'general.password_page.submit' | t }}</button>
      {% endform %}
    </div>
  </div>
</div>
