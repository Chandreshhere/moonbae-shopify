    "faq": {
      "type": "faq",
      "blocks": {
        "q-1": {
          "type": "question",
          "settings": {
            "question": "How long does delivery take?",
            "answer": "<p>Every piece is printed after you order, which takes 2–4 business days. Delivery inside India is then 3–7 business days to metro cities and up to 12 for other pin codes — usually 5–11 business days door to door. You get a tracking link by email the moment it ships.</p>"
          }
        },
        "q-2": {
          "type": "question",
          "settings": {
            "question": "Can I return or exchange it?",
            "answer": "<p>Each piece is made for you individually, so we can't take returns for change of mind or fit — please check the size guide before ordering, and ask us if you're between sizes. If it arrives damaged, misprinted or wrong, we replace or refund it free. Write to us within 5 days of delivery.</p>"
          }
        },
        "q-3": {
          "type": "question",
          "settings": {
            "question": "Why do you ask for an unboxing video?",
            "answer": "<p>One continuous, unedited recording from the sealed parcel to the item coming out. It takes ten seconds and it's the only proof that a fault didn't happen after delivery — without it our printers won't accept a claim, so neither can we.</p>"
          }
        },
        "q-4": {
          "type": "question",
          "settings": {
            "question": "Can I cancel an order?",
            "answer": "<p>Yes, within 1 hour of placing it. Our printers begin production almost immediately, so the window is short — email us the moment you know. After that the piece exists only for you and can't be cancelled.</p>"
          }
        },
        "q-5": {
          "type": "question",
          "settings": {
            "question": "How do the sizes run?",
            "answer": "<p>Our tees are cut oversized — size down if you want a closer fit. Garments are hand-cut and can vary by up to ±0.5 inch from the size guide, which is standard for apparel and not a fault.</p>"
          }
        },
        "q-6": {
          "type": "question",
          "settings": {
            "question": "How do I look after it?",
            "answer": "<p>Wash cold, inside out, on a gentle cycle. No bleach. Hang to dry or tumble low. Don't iron directly over the print. Treated this way it will soften with every wash and last for years.</p>"
          }
        },
        "q-7": {
          "type": "question",
          "settings": {
            "question": "Where is it made?",
            "answer": "<p>India. Cut, printed and finished in small runs, close to the people who make it. Nothing is made in bulk or warehoused — each piece is made once someone asks for it.</p>"
          }
        }
      },
