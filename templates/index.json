    "community": {
      "type": "community-section",
      "blocks": {
        "partner-1": {
          "type": "partner",
          "settings": {
            "title": "Raw, on purpose",
            "text": "<p>The art goes on the shirt the way it came off the page. No smoothing, no committee. If the line shakes, the line shakes.</p>",
            "url": "",
            "link_label": ""
          }
        },
        "partner-2": {
          "type": "partner",
          "settings": {
            "title": "Made after dark",
            "text": "<p>Most of this was drawn at night by people who should have been asleep. That energy is the whole point.</p>",
            "url": "",
            "link_label": ""
          }
        },
        "partner-3": {
          "type": "partner",
          "settings": {
            "title": "One at a time",
            "text": "<p>Printed in India after you order. Nothing sits in a warehouse waiting to be discounted. Each piece exists because you asked for it.</p>",
            "url": "",
            "link_label": ""
          }
        },
        "partner-4": {
          "type": "partner",
          "settings": {
            "title": "For the crazy ones",
            "text": "<p>Artists, misfits, the kid drawing on the back of the exam paper. If you have ever been told to tone it down, this is for you.</p>",
            "url": "",
            "link_label": ""
          }
        }
      },
      "block_order": [
        "partner-1",
        "partner-2",
        "partner-3",
        "partner-4"
      ],
      "settings": {
        "giving_title": "<p>Art back to artists</p>",
        "giving_text": "<p>moonbae was never just clothes. It is a way to get raw art out of sketchbooks and onto the street, and to pay the people who make it. Every graphic is credited, and the artist gets a cut of every piece sold. Real money, not exposure.</p>",
        "list_heading": "What we are about",
        "padding_top": 0,
        "padding_bottom": 0
      }
