{%- comment -%}
  Newsletter signup.

  The reference ships an empty `.klaviyo-form-*` div that the Klaviyo app fills at
  runtime — which is why the popup looks bare without Klaviyo installed. Paste an
  embed into Theme settings → Newsletter → Embed code and it is used verbatim;
  otherwise this renders a real Shopify customer form built from the design's own
  popup classes (.signup-input, .popup-submit, .popup-terms, .popup-btn_wrap).

  Params:
    id       unique suffix for input ids
    variant  'popup' for the full two-field layout, anything else for the compact
             footer layout
{%- endcomment -%}
{%- assign variant = variant | default: 'footer' -%}
{%- assign uid = id | default: 'nl' -%}

<div class="klaviyo-form-SCSKtr signup-form_wrap">
  {%- if settings.newsletter_embed != blank -%}
    {{ settings.newsletter_embed }}
  {%- else -%}
    {% form 'customer', class: 'signup-form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">

      {%- if form.posted_successfully? -%}
        <div class="popup-success">
          <div class="popup-success_wrap u-text-align-center">
            <div class="popup-success_icon">{% render 'brand-mono', variant: 'dark', class: 'is-icon' %}</div>
            <div class="body-upper">{{ settings.newsletter_success_heading }}</div>
            <div class="u-text-style-small f-5">{{ settings.newsletter_success_text }}</div>
          </div>
        </div>
      {%- else -%}
        {%- if variant == 'popup' -%}
          <label class="u-visually-hidden" for="NewsletterName-{{ uid }}">{{ settings.newsletter_name_label }}</label>
          <input
            id="NewsletterName-{{ uid }}"
            type="text"
            name="contact[first_name]"
            class="signup-input body-upper is-first"
            placeholder="{{ settings.newsletter_name_label | escape }}"
            autocomplete="given-name">
        {%- endif -%}

        <label class="u-visually-hidden" for="NewsletterEmail-{{ uid }}">{{ settings.newsletter_label }}</label>
        <input
          id="NewsletterEmail-{{ uid }}"
          type="email"
          name="contact[email]"
          class="signup-input body-upper{% if variant == 'popup' %} is-last{% endif %}"
          value="{{ form.email }}"
          placeholder="{{ settings.newsletter_placeholder | escape }}"
          autocomplete="email"
          autocorrect="off"
          autocapitalize="off"
          required>

        {%- if form.errors -%}
          <p class="body-upper form-error">{{ form.errors.translated_fields.email }} {{ form.errors.messages.email }}</p>
        {%- endif -%}

        <div class="{% if variant == 'popup' %}popup-submit{% else %}signup-submit_layout{% endif %}">
          {%- if variant == 'popup' and settings.newsletter_terms != blank -%}
            <div class="popup-terms">
              <div class="popup-terms_text">{{ settings.newsletter_terms }}</div>
            </div>
          {%- endif -%}
          <button type="submit" class="popup-btn_wrap" aria-label="{{ settings.newsletter_button | escape }}">
            <div class="signup-submit body-upper">{{ settings.newsletter_button }}</div>
            <div class="signup-btn_icon">
              {% render 'icon-link-arrow', class: 'signup-btn_icon-svg' %}
              {% render 'icon-link-arrow', class: 'signup-btn_icon-svg is-2' %}
            </div>
          </button>
        </div>
      {%- endif -%}
    {% endform %}
  {%- endif -%}
</div>
