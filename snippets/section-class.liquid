{%- comment -%}
  Rewrites the wrapper <div class="shopify-section"> that Shopify emits around a
  section so the published markup matches the design exactly, and applies the
  section's own spacing settings to that wrapper.

  Params: classes, attrs (comma separated bare attribute names), id, pt, pb

  The values ride on the <script> tag as data attributes, and the inline code
  applies them on first paint. Barba never executes inline scripts in a page it
  swaps in, so after a transition scripts-2026.js re-applies them by reading the
  same attributes (applySectionClasses). Both paths must stay in step.

  0 for pt/pb means "use the design's own spacing" — only override when the
  merchant has actually dialled a value in, otherwise an inline 0 would wipe
  rules like the about hero's padding-top: 50svh.
{%- endcomment -%}
<script data-section-class="{{ classes | escape }}"{% if attrs != blank %} data-section-attrs="{{ attrs | escape }}"{% endif %}{% if id %} data-section-id="{{ id | escape }}"{% endif %}{% if pt != blank and pt > 0 %} data-section-pt="{{ pt }}"{% endif %}{% if pb != blank and pb > 0 %} data-section-pb="{{ pb }}"{% endif %}>
  (function () {
    var t = document.currentScript, s = t && t.closest('.shopify-section');
    if (!s) return;
    var d = t.dataset;
    if (d.sectionId) s.id = d.sectionId;
    s.setAttribute('class', d.sectionClass);
    if (d.sectionAttrs) d.sectionAttrs.split(',').forEach(function (a) { a = a.trim(); if (a) s.setAttribute(a, ''); });
    if (d.sectionPt) s.style.paddingTop = d.sectionPt + 'px';
    if (d.sectionPb) s.style.paddingBottom = d.sectionPb + 'px';
  })();
</script>
