{%- comment -%}
  Renders an <img> from a section/block image setting, falling back to a bundled
  placeholder asset so the theme looks complete on a brand-new store.

  Params: image, fallback (asset filename), alt, class, sizes, loading, attrs
  attrs takes raw attributes (e.g. block.shopify_attributes) so blocks stay
  selectable in the editor without a wrapper element disturbing the CSS.
{%- endcomment -%}
{%- comment -%} A merchant-set alt on the image itself beats an empty string. {%- endcomment -%}
{%- assign img_alt = alt | default: image.alt | default: '' -%}
{%- assign img_class = class | default: '' -%}
{%- comment -%}
  loading="auto" is not a valid value — the spec allows only lazy and eager —
  so browsers ignored it and nothing below the fold was deferred. Default to
  lazy; pass loading: 'eager' for anything above the fold.
{%- endcomment -%}
{%- assign img_loading = loading | default: 'lazy' -%}
{%- if image != blank -%}
  <img
    src="{{ image | image_url: width: 1920 }}"
    srcset="{{ image | image_url: width: 500 }} 500w, {{ image | image_url: width: 800 }} 800w, {{ image | image_url: width: 1080 }} 1080w, {{ image | image_url: width: 1600 }} 1600w, {{ image | image_url: width: 1920 }} 1920w"
    sizes="{{ sizes | default: '100vw' }}"
    alt="{{ img_alt | escape }}"
    class="{{ img_class }}"
    loading="{{ img_loading }}"
    decoding="async"
    width="{{ image.width }}"
    height="{{ image.height }}"
    {{ attrs }}>
{%- else -%}
  <img src="{{ fallback | asset_url }}" alt="{{ img_alt | escape }}" class="{{ img_class }}" loading="{{ img_loading }}" decoding="async" {{ attrs }}>
{%- endif -%}
