{%- comment -%}
  Renders an <img> from a section/block image setting, falling back to a bundled
  placeholder asset so the theme looks complete on a brand-new store.

  Params: image, image_mobile (optional portrait), fallback (asset filename),
          alt, class, sizes, sizes_mobile, loading, attrs,
          fallback_width ('900x' etc.) to serve the bundled file CDN-resized
  attrs takes raw attributes (e.g. block.shopify_attributes) so blocks stay
  selectable in the editor without a wrapper element disturbing the CSS.
{%- endcomment -%}
{%- comment -%} A merchant-set alt on the image itself beats an empty string. {%- endcomment -%}
{%- assign img_alt = alt | default: image.alt | default: '' -%}
{%- assign img_class = class | default: '' -%}
{%- comment -%}
  loading="auto" is not a valid value — the spec allows only lazy and eager —
  so browsers ignored it and nothing below the fold was deferred. Default to
  lazy; pass loading: 'eager' for anything above the fold.
{%- endcomment -%}
{%- assign img_loading = loading | default: 'lazy' -%}
{%- if image_mobile != blank -%}
  <picture class="responsive-picture">
    <source
      media="(max-width: 767px) and (orientation: portrait)"
      srcset="{{ image_mobile | image_url: width: 480 }} 480w, {{ image_mobile | image_url: width: 750 }} 750w, {{ image_mobile | image_url: width: 1000 }} 1000w"
      sizes="{{ sizes_mobile | default: '100vw' }}"
      width="{{ image_mobile.width }}"
      height="{{ image_mobile.height }}">
{%- endif -%}
{%- if image != blank -%}
  <img
    src="{{ image | image_url: width: 1920 }}"
    srcset="{{ image | image_url: width: 500 }} 500w, {{ image | image_url: width: 800 }} 800w, {{ image | image_url: width: 1080 }} 1080w, {{ image | image_url: width: 1600 }} 1600w, {{ image | image_url: width: 1920 }} 1920w"
    sizes="{{ sizes | default: '100vw' }}"
    alt="{{ img_alt | escape }}"
    class="{{ img_class }}"
    loading="{{ img_loading }}"
    decoding="async"
    width="{{ image.width }}"
    height="{{ image.height }}"
    {{ attrs }}>
{%- else -%}
  {%- if fallback_width != blank -%}{%- assign fb_src = fallback | asset_img_url: fallback_width -%}{%- else -%}{%- assign fb_src = fallback | asset_url -%}{%- endif -%}
  {%- comment -%}
    Bundled photos were sent at full size to every screen, a phone included:
    the home hero (the page's largest paint) among them. Raster files get a
    srcset of CDN-resized copies so the browser picks the size it needs;
    SVGs and the like are left as they are. A caller that caps the width
    (fallback_width) without saying how wide the image shows (sizes) keeps
    its single capped file, since a srcset read against the default 100vw
    could fetch a bigger one than before.
  {%- endcomment -%}
  {%- liquid
    assign fb_ext = fallback | split: '.' | last | downcase
    assign fb_responsive = false
    if fb_ext == 'jpg' or fb_ext == 'jpeg' or fb_ext == 'png' or fb_ext == 'webp'
      if fallback_width == blank or sizes != blank
        assign fb_responsive = true
      endif
    endif
  -%}
  {%- if fb_responsive -%}
    {%- capture fb_srcset -%}{{ fallback | asset_img_url: '640x' }} 640w, {{ fallback | asset_img_url: '960x' }} 960w, {{ fallback | asset_img_url: '1280x' }} 1280w, {{ fallback | asset_img_url: '1920x' }} 1920w{%- endcapture -%}
    <img src="{{ fb_src }}" srcset="{{ fb_srcset }}" sizes="{{ sizes | default: '100vw' }}" alt="{{ img_alt | escape }}" class="{{ img_class }}" loading="{{ img_loading }}" decoding="async" {{ attrs }}>
  {%- else -%}
    <img src="{{ fb_src }}" alt="{{ img_alt | escape }}" class="{{ img_class }}" loading="{{ img_loading }}" decoding="async" {{ attrs }}>
  {%- endif -%}
{%- endif -%}
{%- if image_mobile != blank -%}</picture>{%- endif -%}
