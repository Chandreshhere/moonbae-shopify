{%- comment -%}
  Cart drawer, reproduced verbatim from the reference build.

  The markup, class names, data-node-type hooks, template-part-bind ids and the
  Webflow x-wf-template used to render line items are all unchanged; the drawer is
  driven by the same Udesly bridge (assets/vendor-udesly-shopify.js), which talks to
  Shopify's /cart.js, /cart/add and /cart/change.

  Params: variant — 'nav' (default) or 'menu'
{%- endcomment -%}
{%- assign variant = variant | default: 'nav' -%}

{%- if variant == 'menu' -%}
  {%- assign open_classes = 'menu-cart is-cart' -%}
  {%- assign open_label = settings.cart_menu_label -%}
  {%- assign heading = settings.cart_menu_heading -%}
  {%- assign tpl = 'wf-template-0fe5fc0f-6b29-79dd-c146-30b7dbfd6e86' -%}
{%- else -%}
  {%- assign open_classes = 'nav-link is-cart' -%}
  {%- assign open_label = settings.cart_nav_label -%}
  {%- assign heading = settings.cart_nav_heading -%}
  {%- assign tpl = 'wf-template-7eb9bb6d-58fe-33f2-b579-11521cae270e' -%}
{%- endif -%}
{%- assign empty_url = settings.cart_empty_link_url | default: routes.all_products_collection_url -%}

{%- comment -%}
  data-open-product makes Udesly slide the drawer open as soon as something is added,
  so the line item and the Checkout button are right there. Only on the header drawer —
  the menu one lives inside the closed menu panel.
{%- endcomment -%}
<div data-wf-cart-type="rightSidebar" data-wf-cart-query="" data-wf-page-link-href-prefix="" data-wf-cart-easing="ease" data-wf-cart-duration="0"{% if variant != 'menu' and settings.cart_open_on_add %} data-open-product=""{% endif %} class="w-commerce-commercecartwrapper cart-el" data-node-type="commerce-cart-wrapper">
  <a h-flip="" class="w-commerce-commercecartopenlink {{ open_classes }} w-inline-block" role="button" aria-haspopup="dialog" aria-label="Open cart" data-node-type="commerce-cart-open-link">
    <div class="body-upper w-inline-block">{{ open_label }}</div>
    <div style="" data-count-hide-rule="empty" class="w-commerce-commercecartopenlinkcount cart-total">{{ cart.item_count }}</div>
  </a>
  <div style="display:none" class="w-commerce-commercecartcontainerwrapper w-commerce-commercecartcontainerwrapper--cartType-rightSidebar cart-wrapper" data-node-type="commerce-cart-container-wrapper">
    <div data-node-type="commerce-cart-container" role="dialog" class="w-commerce-commercecartcontainer cart-container">
      <div class="w-commerce-commercecartheader cart-header">
        <h4 class="w-commerce-commercecartheading body-upper">{{ heading }}</h4>
        <a class="w-commerce-commercecartcloselink cart-close w-inline-block" role="button" aria-label="Close cart" data-node-type="commerce-cart-close-link">
          <div class="cart-close_icon body-upper">{{ settings.cart_close_label }}</div>
        </a>
      </div>
      <div class="w-commerce-commercecartformwrapper cart-form_wrap">
        <form style="" class="w-commerce-commercecartform default-state" data-node-type="commerce-cart-form">
          <div class="w-commerce-commercecartlist cart-list" data-wf-collection="database.commerceOrder.userItems" data-wf-template-id="{{ tpl }}" data-lenis-prevent=""></div>
          {%- if variant == 'menu' -%}
            <script type="text/x-wf-template" id="{{ tpl }}"><div data-node-type="cart-item" class="cart-item w-commerce-commercecartitem" template-part-bind="0fe5fc0f-6b29-79dd-c146-30b7dbfd6e87"><div class="checkout-img_wrap"><img data-node-type="cart-item-image" class="checkout-img w-commerce-commercecartitemimage" template-part-bind="0fe5fc0f-6b29-79dd-c146-30b7dbfd6e88" src="<%= it.image %>"></div><div data-node-type="cart-item-info" class="cart-details_contain w-commerce-commercecartiteminfo" template-part-bind="0fe5fc0f-6b29-79dd-c146-30b7dbfd6e89"><div data-node-type="cart-product-name" class="heading_main w-commerce-commercecartproductname" template-part-bind="0fe5fc0f-6b29-79dd-c146-30b7dbfd6e8a"><%= it.title %></div><div class="field_copy" template-part-bind="0fe5fc0f-6b29-79dd-c146-30b7dbfd6e8b"><%= it.price %></div><a data-node-type="cart-remove-link" class="remove_contain" href="#" role="button" template-part-bind="0fe5fc0f-6b29-79dd-c146-30b7dbfd6e8c" data-product-id="<%= it.id %>"><div class="field_copy">{{ settings.cart_remove_menu_label }}</div></a><ul template-part-bind="0fe5fc0f-6b29-79dd-c146-30b7dbfd6e8f" class="w-commerce-commercecartoptionlist"><% Object.entries(it.properties).forEach( data =>  { %><li data-node-type="cart-option-list-item"><span data-node-type="cart-option-list-item-label" template-part-bind="0fe5fc0f-6b29-79dd-c146-30b7dbfd6e91"><%= data[0] %></span><span data-node-type="span">: </span><span data-node-type="cart-option-list-item-value" template-part-bind="0fe5fc0f-6b29-79dd-c146-30b7dbfd6e94"><%= data[1] %></span></li><% }) %></ul></div><input class="w-commerce-commercecartquantity" name="<%= it.id %>" type="number" min="0" value="<%= it.quantity %>" data-node-type="cart-quantity"></div></script>
          {%- else -%}
            <script type="text/x-wf-template" id="{{ tpl }}"><div data-node-type="cart-item" class="cart-item w-commerce-commercecartitem" template-part-bind="7eb9bb6d-58fe-33f2-b579-11521cae270f"><div class="checkout-img_wrap"><img data-node-type="cart-item-image" class="checkout-img w-commerce-commercecartitemimage" template-part-bind="7eb9bb6d-58fe-33f2-b579-11521cae2710" src="<%= it.image %>"></div><div data-node-type="cart-item-info" class="cart-details_contain w-commerce-commercecartiteminfo" template-part-bind="7eb9bb6d-58fe-33f2-b579-11521cae2711"><div data-node-type="cart-product-name" class="heading_main w-commerce-commercecartproductname" template-part-bind="7eb9bb6d-58fe-33f2-b579-11521cae2712"><%= it.title %></div><div class="cart-item_price"><div class="body-upper" template-part-bind="7eb9bb6d-58fe-33f2-b579-11521cae2713"><%= it.price %></div></div><ul template-part-bind="7eb9bb6d-58fe-33f2-b579-11521cae2717" class="w-commerce-commercecartoptionlist"><% Object.entries(it.properties).forEach( data =>  { %><li data-node-type="cart-option-list-item" class="field_copy"><span data-node-type="cart-option-list-item-label" template-part-bind="7eb9bb6d-58fe-33f2-b579-11521cae2719"><%= data[0] %></span><span data-node-type="span">: </span><span data-node-type="cart-option-list-item-value" template-part-bind="7eb9bb6d-58fe-33f2-b579-11521cae271c"><%= data[1] %></span></li><% }) %></ul><a data-node-type="cart-remove-link" class="remove_contain" href="#" role="button" template-part-bind="7eb9bb6d-58fe-33f2-b579-11521cae2714" data-product-id="<%= it.id %>"><div class="field_copy">{{ settings.cart_remove_nav_label }}</div></a></div><input class="w-commerce-commercecartquantity" name="<%= it.id %>" type="number" min="0" value="<%= it.quantity %>" data-node-type="cart-quantity"></div></script>
          {%- endif -%}
          <div class="w-commerce-commercecartfooter cart-footer">
            <div aria-atomic="true" aria-live="polite" class="w-commerce-commercecartlineitem cart-line_item">
              <div class="field_copy">{{ settings.cart_subtotal_label }}</div>
              <div class="w-commerce-commercecartordervalue body-upper">{{ cart.total_price | money_with_currency }}</div>
            </div>
            <div aria-atomic="true" aria-live="polite" class="w-commerce-commercecartlineitem cart-line_item">
              <div class="field_copy">{{ settings.cart_shipping_label }}</div>
              <div class="{% if variant == 'menu' %} {% endif %}body-upper">{{ settings.cart_shipping_note }}</div>
            </div>
            <div class="checkout-actions">
              <div data-node-type="commerce-cart-quick-checkout-actions" class="web-payments"></div>
              <a href="/checkout" data-barba-prevent="self" value="Checkout" class="w-commerce-commercecartcheckoutbutton checkout-button body-upper" data-loading-text="Hang Tight..." data-node-type="cart-checkout-button">{{ settings.cart_checkout_label }}</a>
            </div>
          </div>
        </form>
        <div class="w-commerce-commercecartemptystate empty-state">
          <div class="empty-cart_layout">
            <p class="text-style_alt-large"></p>
            <div aria-label="This cart is empty" aria-live="polite" class="body-upper f-5">{{ settings.cart_empty_text }}</div>
            <div class="cart-shop_more">
              <a href="{{ empty_url }}" class="orgc-detail w-inline-block">
                {% render 'icon-bracket-left' %}
                <div data-text="{{ settings.cart_empty_link_label | escape }}" class="detail-wrap body-upper">
                  <div class="detail-text">{{ settings.cart_empty_link_label }}</div>
                </div>
                {% render 'icon-bracket-right' %}
              </a>
            </div>
          </div>
        </div>
        <div aria-live="assertive" style="display:none" data-node-type="commerce-cart-error" class="w-commerce-commercecarterrorstate error-state">
          <div class="{% unless variant == 'menu' %}body-upper {% endunless %}w-cart-error-msg" data-w-cart-quantity-error="{{ settings.cart_error_text | escape }}" data-w-cart-general-error="Something went wrong when adding this item to the cart." data-w-cart-checkout-error="Checkout is disabled on this site.">{{ settings.cart_error_text }}</div>
        </div>
      </div>
    </div>
  </div>
</div>
