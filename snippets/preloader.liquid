<div class="preloader_wrap">
  <div class="preloader-inner">
    <div class="preloader_logo-contain">{% render 'brand-logo', variant: 'light', class: 'is-preloader' %}</div>
    <div class="preloader-inner_bg"></div>
    <div class="preloader_img-contain">
      {%- assign preload_imgs = 'moonbae-grocery-babytee-mobile-20261122.jpg,moonbae-hoodie-studio-mobile-20261122.jpg,moonbae-street-crew-mobile-20261122.jpg,moonbae-sofa-babytee-mobile-20261122.jpg,moonbae-roadside-tees-mobile-20261122.jpg,moonbae-hoodie-studio-desktop-20261122.jpg,moonbae-street-crew-desktop-20261122.jpg,moonbae-grocery-babytee-desktop-20261122.jpg' | split: ',' -%}
      {%- for file in preload_imgs -%}
        {%- assign key = 'preloader_image_' | append: forloop.index -%}
        {% render 'img', image: settings[key], fallback: file, fallback_width: '900x', class: 'preloader-img' %}
      {%- endfor -%}
    </div>
  </div>
</div>
