<div class="preloader_wrap">
  <div class="preloader-inner">
    <div class="preloader_logo-contain">{% render 'brand-mono', variant: 'light', class: 'is-preloader' %}</div>
    <div class="preloader-inner_bg"></div>
    <div class="preloader_img-contain">
      {%- assign preload_imgs = 'or-menu-hover-1.jpg,or-preloader-2.jpg,or-giving.jpg,or-preloader-4.jpg,or-preloader-5.jpg,or-preloader-6.jpg,or-preloader-7.jpg,or-preloader-8.jpg' | split: ',' -%}
      {%- for file in preload_imgs -%}
        {%- assign key = 'preloader_image_' | append: forloop.index -%}
        {% render 'img', image: settings[key], fallback: file, class: 'preloader-img' %}
      {%- endfor -%}
    </div>
  </div>
</div>
