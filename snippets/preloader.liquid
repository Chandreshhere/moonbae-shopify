<div class="preloader_wrap">
  <div class="preloader-inner">
    <div class="preloader_logo-contain">{% render 'brand-logo', variant: 'light', class: 'is-preloader' %}</div>
    <div class="preloader-inner_bg"></div>
    <div class="preloader_img-contain">
      {%- assign preload_imgs = 'moonbae-07.jpg,moonbae-03.jpg,moonbae-09.jpg,moonbae-04.jpg,moonbae-05.jpg,moonbae-06.jpg,moonbae-07.jpg,moonbae-08.jpg' | split: ',' -%}
      {%- for file in preload_imgs -%}
        {%- assign key = 'preloader_image_' | append: forloop.index -%}
        {% render 'img', image: settings[key], fallback: file, fallback_width: '900x', class: 'preloader-img' %}
      {%- endfor -%}
    </div>
  </div>
</div>
